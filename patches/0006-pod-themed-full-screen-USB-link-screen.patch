diff --git a/apps/gui/usb_screen.c b/apps/gui/usb_screen.c
index b1a12d2d83..2d2b3249cf 100644
--- a/apps/gui/usb_screen.c
+++ b/apps/gui/usb_screen.c
@@ -140,6 +140,16 @@ static void usb_screen_fix_viewports(struct screen *screen,
         logo_height = BMPHEIGHT_usblogo;
     }
 
+#if BMPHEIGHT_usblogo == LCD_HEIGHT
+    /* the logo is a complete screen: no status bar around it */
+    if (screen->screen_type == SCREEN_MAIN)
+    {
+        viewportmanager_theme_enable(screen->screen_type, false, NULL);
+        memset(parent, 0, sizeof(*parent)); /* no stale buffer pointer */
+        viewport_set_fullscreen(parent, screen->screen_type);
+    }
+    else
+#endif
     viewportmanager_theme_enable(screen->screen_type, true, parent);
 
     if (logo_width  > parent->width)
@@ -216,6 +226,11 @@ static void usb_screens_draw(struct usb_screen_vps_t *usb_screen_vps_ar)
         screen->backlight_on();
         screen->set_viewport(logo);
         screen->bmp(logos[i], 0, 0);
+#if BMPHEIGHT_usblogo == LCD_HEIGHT
+        /* without the theme nothing else pushes this to the LCD */
+        screen->set_viewport(NULL);
+        screen->update();
+#endif
         screen->set_viewport(last_vp);
     }
 #ifdef USB_ENABLE_HID
