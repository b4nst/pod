@@ -140,6 +140,16 @@ static void usb_screen_fix_viewports(struct screen *screen,
         logo_height = BMPHEIGHT_usblogo;
     }
 
+#if BMPHEIGHT_usblogo == LCD_HEIGHT
+    /* the logo is a complete screen: no status bar around it */
+    if (screen->screen_type == SCREEN_MAIN)
+    {
+        viewportmanager_theme_enable(screen->screen_type, false, NULL);
+        memset(parent, 0, sizeof(*parent)); /* no stale buffer pointer */
+        viewport_set_fullscreen(parent, screen->screen_type);
+    }
+    else
+#endif
     viewportmanager_theme_enable(screen->screen_type, true, parent);
 
