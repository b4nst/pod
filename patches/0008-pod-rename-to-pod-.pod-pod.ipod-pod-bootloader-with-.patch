diff --git a/bootloader/ipod.c b/bootloader/ipod.c
index 653169dade..6054caaaee 100644
--- a/bootloader/ipod.c
+++ b/bootloader/ipod.c
@@ -41,6 +41,7 @@
 #include "power.h"
 #include "file.h"
