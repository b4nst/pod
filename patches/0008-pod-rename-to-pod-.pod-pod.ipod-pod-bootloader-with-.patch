From 8ebf2e0e04448e3eba2db6e19abdb1c1371c91fd Mon Sep 17 00:00:00 2001
From: banst <bastien@banst.ch>
Date: Thu, 5 Nov 2026 09:37:59 +0100
Subject: [PATCH 8/8] pod: rename to pod: /.pod/pod.ipod, pod bootloader with
 the splash

The firmware, its data and the boot file move from /.rockbox/rockbox.ipod
to /.pod/pod.ipod, so the iPod mini needs the matching bootloader built
from this tree. The bootloader holds the splash from power on. The UI says
pod, and the System screen points to the source and the license.
---
 apps/lang/english.lang              |  8 ++++----
 apps/menus/main_menu.c              | 10 ++++++++++
 apps/tagnavi.config                 |  6 +++---
 apps/tree.c                         |  4 ++--
 bootloader/ipod.c                   | 19 ++++++++++++++++---
 firmware/export/config/ipodmini1g.h |  2 +-
 firmware/export/config/ipodmini2g.h |  2 +-
 tools/configure                     |  6 +++---
 8 files changed, 40 insertions(+), 17 deletions(-)

diff --git a/apps/lang/english.lang b/apps/lang/english.lang
index a796b0aa9a..3e2e967655 100644
--- a/apps/lang/english.lang
+++ b/apps/lang/english.lang
@@ -95,10 +95,10 @@
     *: "Rockbox"
   </source>
   <dest>
-    *: "Rockbox"
+    *: "pod"
   </dest>
   <voice>
-    *: "Rockbox"
+    *: "pod"
   </voice>
 </phrase>
 <phrase>
@@ -5935,10 +5935,10 @@
     *: "Rockbox Info"
   </source>
   <dest>
-    *: "Rockbox Info"
+    *: "System"
   </dest>
   <voice>
-    *: "Rockbox Info"
+    *: "System"
   </voice>
 </phrase>
 <phrase>
diff --git a/apps/menus/main_menu.c b/apps/menus/main_menu.c
index d987f3d2aa..a7f6aee631 100644
--- a/apps/menus/main_menu.c
+++ b/apps/menus/main_menu.c
@@ -52,6 +52,10 @@
 #include "disk.h"
 
 static const struct browse_folder_info config = {ROCKBOX_DIR, SHOW_CFG};
+/* split to fit the 138 px wide screen */
+#define POD_SOURCE_HOST "github.com"
+#define POD_SOURCE_PATH "/b4nst/pod"
+
 static int show_info(void);
 /***********************************/
 /*    MANAGE SETTINGS MENU        */
@@ -452,6 +456,12 @@ static int info_action_callback(int action, struct gui_synclist *lists)
         }
     }
 
+/* pod is free software: say where its source is */
+    simplelist_setline("License: GPLv2");
+    simplelist_setline("Source:");
+    simplelist_setline(POD_SOURCE_HOST);
+    simplelist_setline(POD_SOURCE_PATH);
+
     return action;
 }
 
diff --git a/apps/tagnavi.config b/apps/tagnavi.config
