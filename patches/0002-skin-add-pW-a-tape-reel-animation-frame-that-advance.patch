From aaf3d6d6e16777a0416614174580383331137b24 Mon Sep 17 00:00:00 2001
From: banst <cycles@banst.ch>
Date: Wed, 4 Nov 2026 21:37:48 +0100
Subject: [PATCH 2/6] skin: add %pW, a tape reel animation frame that advances
 while playing

Claude-Session: https://claude.ai/code/session_016WAUF3TsZL9kusqffkgzF3
---
 apps/gui/skin_engine/skin_tokens.c | 8 ++++++++
 lib/skin_parser/tag_table.c        | 1 +
 lib/skin_parser/tag_table.h        | 1 +
 3 files changed, 10 insertions(+)

diff --git a/apps/gui/skin_engine/skin_tokens.c b/apps/gui/skin_engine/skin_tokens.c
index 50faaa7ec1..b18eedc99c 100644
--- a/apps/gui/skin_engine/skin_tokens.c
+++ b/apps/gui/skin_engine/skin_tokens.c
@@ -472,6 +472,14 @@ const char *get_id3_token(struct wps_token *token, struct mp3entry *id3,
                 else
                     return "?";
                 return buf;
+            case SKIN_TOKEN_TRACK_REEL_FRAME:
+                /* tape reel animation: next frame every 200ms of playback,
+                   so the reels stop turning on pause */
+                if (intval && limit != TOKEN_VALUE_ONLY && limit > 0)
+                    *intval = (elapsed / 200) % limit + 1;
+                itoa_buf(buf, buf_size, (elapsed / 200) % 4);
+                return buf;
+
             case SKIN_TOKEN_TRACK_TIME_ELAPSED:
                 if (intval && limit == TOKEN_VALUE_ONLY)
                     *intval = elapsed/1000;
diff --git a/lib/skin_parser/tag_table.c b/lib/skin_parser/tag_table.c
index 2e74c440b3..03834aa63b 100644
--- a/lib/skin_parser/tag_table.c
+++ b/lib/skin_parser/tag_table.c
@@ -155,6 +155,7 @@ static const struct tag_info legal_tags[] =
     TAG(SKIN_TOKEN_PROGRESSBAR,           "pb" , BAR_PARAMS, SKIN_REFRESH_PLAYER_PROGRESS),
     TAG(SKIN_TOKEN_VOLUME,                "pv" , BAR_PARAMS, SKIN_REFRESH_DYNAMIC),
     TAG(SKIN_TOKEN_TRACK_ELAPSED_PERCENT, "px", "", SKIN_REFRESH_DYNAMIC),
+    TAG(SKIN_TOKEN_TRACK_REEL_FRAME,      "pW", "", SKIN_REFRESH_DYNAMIC),
     TAG(SKIN_TOKEN_TRACK_TIME_ELAPSED,    "pc", "", SKIN_REFRESH_DYNAMIC),
     TAG(SKIN_TOKEN_TRACK_TIME_REMAINING,  "pr", "", SKIN_REFRESH_DYNAMIC),
     TAG(SKIN_TOKEN_TRACK_LENGTH,          "pt", "", SKIN_REFRESH_STATIC),
diff --git a/lib/skin_parser/tag_table.h b/lib/skin_parser/tag_table.h
index 92647c1bdd..b630c99751 100644
--- a/lib/skin_parser/tag_table.h
+++ b/lib/skin_parser/tag_table.h
@@ -200,6 +200,7 @@ enum skin_token_type {
 
     /* Current track */
     SKIN_TOKEN_TRACK_ELAPSED_PERCENT,
+    SKIN_TOKEN_TRACK_REEL_FRAME,
     SKIN_TOKEN_TRACK_TIME_ELAPSED,
     SKIN_TOKEN_TRACK_TIME_REMAINING,
     SKIN_TOKEN_TRACK_LENGTH,
