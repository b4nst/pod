#! rockbox/tagbrowser/2.0
# pod library: replaces the stock database menu.

%format "fmt_track"  "%02d %s" tracknum title ? tracknum > "0"
%format "fmt_track"  "%s" title
# an artist's albums by year, undated last: %strip drops the 4 sort characters
%format "fmt_year_album" "%04d%s" year album %strip = "4" ? year > "0"
%format "fmt_year_album" "9999%s" album %strip = "4"
%format "fmt_recent" "%s - %s" canonicalartist album

%menu_start "main" "Library"
"Artists"        -> canonicalartist -> album = "fmt_year_album" -> title = "fmt_track"
"Albums"         -> album -> title = "fmt_track"
"Songs"          -> title
"Genres"         -> genre -> canonicalartist -> album = "fmt_year_album" -> title = "fmt_track"
"Recently Added" -> album ? entryage < "4" & commitid > "0" -> title = "fmt_track"
"Shuffle All"    ~> title = "fmt_track"

%root_menu "main"
