+++ b/apps/gui/skin_engine/skin_tokens.c
@@ -484,6 +484,14 @@ const char *get_id3_token(struct wps_token *token, struct mp3entry *id3,
                 /* set while SELECT has the wheel scrubbing the track */
                 return state->scrubbing ? "s" : NULL;
 
+            case SKIN_TOKEN_TRACK_LOVE_FLASH:
+                /* the case to show for 1s: 1 after a love, 2 after an unlove */
+                if (!state->love_flash)
+                    return NULL;
+                if (intval)
+                    *intval = state->love_flash;
+                return "h";
+
             case SKIN_TOKEN_TRACK_TIME_ELAPSED:
                 if (intval && limit == TOKEN_VALUE_ONLY)
                     *intval = elapsed/1000;
diff --git a/apps/gui/wps.c b/apps/gui/wps.c
index 82398ab1b18a1d396ce4fec9fd102f50d8519c70..e9d3d3d2b01eba106bef26fb13158082e797d548 100644
--- a/apps/gui/wps.c
+++ b/apps/gui/wps.c
@@ -46,6 +46,7 @@
 #include "onplay.h"
 #include "abrepeat.h"
 #include "playback.h"
+#include "tagcache.h"
 #include "splash.h"
 #include "cuesheet.h"
 #include "ata_idle_notify.h"
@@ -396,6 +397,25 @@ static void scrub_seek(struct wps_state *state, bool *moved, bool keep)
     state->ff_rewind_count = 0;
 }
 
+/* pod: double SELECT loves the playing track: rating 10, or 0 to unlove */
+static void wps_love(struct wps_state *state)
+{
+    struct mp3entry *id3 = state->id3;
+
+    if (!id3 || !id3->tagcache_idx || !global_settings.runtimedb)
+    {
+        splash(HZ, ID2P(LANG_ID3_NO_INFO));
+        return;
+    }
+    id3->rating = id3->rating ? 0 : 10;
+    tagcache_update_numeric(id3->tagcache_idx - 1, tag_rating, id3->rating);
+    state->love_flash = id3->rating ? 1 : 2;
+    state->love_until = current_tick + HZ;
+#ifdef SIMULATOR
+    fprintf(stderr, "pod: love %d\n", id3->rating);
+#endif
+}
+
 static void gwps_caption_backlight(struct wps_state *state)
 {
 #if defined(HAVE_BACKLIGHT) || defined(HAVE_REMOTE_LCD)
@@ -882,7 +902,8 @@ long gui_wps_show(void)
             && button != ACTION_WPS_VOLUP && button != ACTION_WPS_VOLDOWN)
         {
             scrub_seek(state, &scrub_moved, button != ACTION_WPS_SKIPPREV
-                                            && button != ACTION_WPS_SKIPNEXT);
+                                            && button != ACTION_WPS_SKIPNEXT
+                                            && button != ACTION_WPS_LOVE);
             state->scrubbing = false;
             update = true;
         }
@@ -964,6 +985,11 @@ long gui_wps_show(void)
                 update = true;
                 break;
 
+            case ACTION_WPS_LOVE:
+                wps_love(state);
+                update = true;
+                break;
+
             case ACTION_WPS_VOLUP: /* fall through */
             case ACTION_WPS_VOLDOWN:
                 if (state->scrubbing)
@@ -1208,6 +1234,12 @@ long gui_wps_show(void)
                 break;
         }
 
+        if (state->love_flash && TIME_AFTER(current_tick, state->love_until))
+        {
+            state->love_flash = 0;
+            update = true;
+        }
+
         if (state->scrubbing)
         {
             if (scrub_moved && TIME_AFTER(current_tick, scrub_seek_at))
@@ -1257,6 +1289,7 @@ static void wps_state_init(void)
     struct wps_state *state = get_wps_state();
     state->paused = false;
     state->scrubbing = false;
+    state->love_flash = 0;
     state->ff_rewind_count = 0;
     if(audio_status() & AUDIO_STATUS_PLAY)
     {
