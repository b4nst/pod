+    int step = paused ? 0 : (current_tick / (HZ / 5)) % 8;
+
+    d->set_foreground(paused ? POD_MID : POD_INK);
+    d->drawrect(x, y, 19, 11);
+    d->hline(x + 5, x + 13, y + 8);
+    for (int h = 0; h < 2; h++)
+    {
+        int cx = x + 5 + h * 8, cy = y + 4;
