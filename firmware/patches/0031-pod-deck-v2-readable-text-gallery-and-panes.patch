+/* the mixes and the queue have the first pane only */
+static int pane_count(const struct deck_album *a)
+{
+    return is_queue(a) || is_mix(a) ? 1 : PANE_N;
+}
+
+/* a row of a pane, cut to its width */
+static void pane_text(struct screen *d, int row, unsigned fg, const char *s)
+{
+    d->set_foreground(fg);
+    tape_text(d, FONT_UI, PANE_X, PANE_Y + row * PANE_ROW, PANE_W, s, false);
+}
+
+/* a 7x7 star: 0 empty, 1 half, 2 full */
+static void draw_star(struct screen *d, int x, int y, int state)
+{
+    static const char star[7][8] = {
+        "...#...", "..###..", "#######", ".#####.", "..###..", ".##.##.",
+        ".#...#.",
+    };
+
+    for (int j = 0; j < 7; j++)
+        for (int i = 0; i < 7; i++)
+            if (star[j][i] == '#')
+            {
+                d->set_foreground(state == 2 || (state == 1 && i < 4)
+                                  ? POD_INK : POD_FAINT);
+                d->drawpixel(x + i, y + j);
+            }
+}
+
+/* the artist and album with the length of the tape, or a mix's rule */
+static void draw_pane_details(struct screen *d, const struct deck *k,
+                              const struct deck_album *t)
+{
+    char buf[24];
+    int n = t->end - t->start, secs = 0;
+
+    if (t->start < 0)
+    {
+        pane_text(d, 0, POD_INK, t->album);
+        pane_text(d, 1, POD_MID, album_sub(k, t));
+        return;
+    }
+    for (int i = t->start; i < t->end; i++)
+        secs += k->tracks[i].secs;
+    pane_text(d, 0, POD_MID, t->artist);
+    pane_text(d, 1, POD_INK, t->album);
+    snprintf(buf, sizeof(buf), "%d track%s  %d:%02d", n, n == 1 ? "" : "s",
+             secs / 60, secs % 60);
+    pane_text(d, 2, POD_MID, buf);
+}
+
+/* three titles around the selected one, which is inverted */
+static void draw_pane_tracks(struct screen *d, const struct deck *k,
+                             const struct deck_album *t, int sel)
+{
+    struct tagcache_search tcs;
+    char title[MAX_PATH], buf[40];
+    int n = t->end - t->start;
+    int first = MAX(0, MIN(sel - 1, n - PANE_N));
+    bool found = tagcache_search(&tcs, tag_filename);
+
+    for (int r = 0; r < PANE_N && first + r < n; r++)
+    {
+        int i = first + r;
+
+        title[0] = '\0';
+        if (found)
+            get_tag(&tcs, k->tracks[t->start + i].idx, tag_title, title,
+                    sizeof(title));
+        snprintf(buf, sizeof(buf), "%02d %.32s", i + 1, title);
+        if (i == sel)
+        {
+            d->set_foreground(POD_INK);
+            d->fillrect(PANE_X - 1, PANE_Y + r * PANE_ROW, PANE_W + 1,
+                        PANE_ROW);
+        }
+        pane_text(d, r, i == sel ? POD_PAPER : POD_INK, buf);
+    }
+    if (found)
+        tagcache_search_finish(&tcs);
+}
+
+/* how often it was played, how long ago, and the average rating */
+static void draw_pane_stats(struct screen *d, const struct deck *k,
+                            const struct deck_album *t)
+{
+    char buf[24];
+    int plays = 0, rated = 0, sum = 0, halves;
+    long last = 0;
+
+    for (int i = t->start; i < t->end; i++)
+    {
+        const struct deck_track *r = &k->tracks[i];
+
+        plays += r->plays;
+        last = MAX(last, r->last);
+        if (r->rating)
+        {
+            rated++;
+            sum += r->rating;
+        }
+    }
+    snprintf(buf, sizeof(buf), "played %d", plays);
+    pane_text(d, 0, POD_INK, buf);
+    /* the tagcache only keeps a counter of the plays of the library */
+    snprintf(buf, sizeof(buf), "last %ld plays ago",
+             tagcache_get_serial() - last);
+    pane_text(d, 1, POD_MID, last ? buf : "never");
+    halves = rated ? (sum + rated / 2) / rated : 0;
+    for (int i = 0; i < 5; i++)
+        draw_star(d, PANE_X + i * STAR_W, PANE_Y + 2 * PANE_ROW + 2,
+                  halves >= 2 * i + 2 ? 2 : halves == 2 * i + 1 ? 1 : 0);
+}
