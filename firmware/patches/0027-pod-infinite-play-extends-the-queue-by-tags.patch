diff --git a/apps/pod_infinite.c b/apps/pod_infinite.c
new file mode 100644
index 0000000000000000000000000000000000000000..bebd8c33b28e9d7246188be7f0674a6d4c416c50
--- /dev/null
+++ b/apps/pod_infinite.c
@@ -0,0 +1,194 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * Copyright (C) 2026 banst
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+/*
+ * Infinite play: when the queue runs out, up to INFINITE_ADD tracks from the
+ * library join its end. They are picked by tags, best first: the genre and a
+ * year within 5 of the last track by another artist, the genre by another
+ * artist, the genre, anything. A track played in the last RECENT_PLAYS plays
+ * or among the last QUEUE_LOOKBACK of the queue is never picked.
+ */
+
+#include "config.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "system.h"
+#include "file.h"
+#include "playlist.h"
+#include "settings.h"
+#include "tagcache.h"
+#include "pod_infinite.h"
+
+#define INFINITE_ADD    10
+#define RECENT_PLAYS    150
+#define QUEUE_LOOKBACK  32
+#define YEAR_SPAN       5
+#define TIERS           4
+#define TAG_BUF         64
+
+/* static: the audio thread's stack is small */
+static struct tagcache_search tcs;
+static char path[MAX_PATH];
+static char seed_genre[TAG_BUF], seed_artist[TAG_BUF];
+static char genre[TAG_BUF], artist[TAG_BUF];
+static int queued[QUEUE_LOOKBACK];
+static int pick[TIERS][INFINITE_ADD];
+static int seen[TIERS];
+
+int pod_infinite_toggle(void)
+{
+    global_settings.pod_infinite = !global_settings.pod_infinite;
+    settings_save();
+    return 0;
+}
+
+char *pod_infinite_getname(int selected_item, void *data, char *buffer,
+                           size_t buffer_len)
+{
+    (void)selected_item;
+    (void)data;
+    snprintf(buffer, buffer_len, "Infinite: %s",
+             global_settings.pod_infinite ? "On" : "Off");
+    return buffer;
+}
+
+static bool is_queued(int idx_id, int count)
+{
+    int i;
+
+    for (i = 0; i < count; i++)
+        if (queued[i] == idx_id)
+            return true;
+    return false;
+}
+
+/* Keep a random INFINITE_ADD of the tracks seen in each tier */
+static void sample(int tier, int idx_id)
+{
+    int n = seen[tier]++;
+
+    if (n < INFINITE_ADD)
+        pick[tier][n] = idx_id;
+    else if ((n = rand() % seen[tier]) < INFINITE_ADD)
+        pick[tier][n] = idx_id;
+}
+
+int pod_infinite_extend(int last)
+{
+    int i, t, count = 0, added = 0;
+    bool full = false;
+    long serial, seed_year;
+
+    if (!global_settings.pod_infinite
+        || global_settings.repeat_mode != REPEAT_OFF
+        || !playlist_peek(last, path, sizeof(path)))
+        return 0;
+
+    /* a full queue splashes for 2 s on every insert */
+    if (playlist_amount() + INFINITE_ADD
+        > global_settings.max_files_in_playlist)
+        return 0;
+
+    /* the last track is the seed: not in the library, nothing to go by */
+    if (!tagcache_find_index(&tcs, path))
+        return 0;
+    tagcache_retrieve(&tcs, tcs.idx_id, tag_genre, seed_genre, TAG_BUF);
+    tagcache_retrieve(&tcs, tcs.idx_id, tag_artist, seed_artist, TAG_BUF);
+    seed_year = tagcache_get_numeric(&tcs, tag_year);
+    tagcache_search_finish(&tcs);
+
+    /* the tracks the queue ends with */
+    for (i = 0; i < QUEUE_LOOKBACK
+                && playlist_peek(last - i, path, sizeof(path)); i++)
+    {
+        if (!tagcache_find_index(&tcs, path))
+            continue;
+        queued[count++] = tcs.idx_id;
+        tagcache_search_finish(&tcs);
+    }
+
+    /* tag_lastplayed is a play counter of the library, not a time */
+    serial = tagcache_get_serial();
+    memset(seen, 0, sizeof(seen));
+    if (!tagcache_search(&tcs, tag_filename))
+        return 0;
+    while (tagcache_get_next(&tcs, path, sizeof(path)))
+    {
+        long played = tagcache_get_numeric(&tcs, tag_lastplayed);
+        bool same_genre, other_artist, near_year;
+
+        if ((played > 0 && serial - played < RECENT_PLAYS)
+            || is_queued(tcs.idx_id, count))
+            continue;
+
+        tagcache_retrieve(&tcs, tcs.idx_id, tag_genre, genre, TAG_BUF);
+        tagcache_retrieve(&tcs, tcs.idx_id, tag_artist, artist, TAG_BUF);
+        same_genre = seed_genre[0] && !strcasecmp(genre, seed_genre);
+        other_artist = strcasecmp(artist, seed_artist) != 0;
+        i = tagcache_get_numeric(&tcs, tag_year);
+        near_year = seed_year > 0 && i > 0 && abs(i - seed_year) <= YEAR_SPAN;
+
+        if (same_genre && near_year && other_artist)
+            t = 0;
+        else if (same_genre && other_artist)
+            t = 1;
+        else if (same_genre)
+            t = 2;
+        else
+            t = 3;
+        sample(t, tcs.idx_id);
+    }
+
+    /* best tiers first */
+    for (t = 0; t < TIERS && !full && added < INFINITE_ADD; t++)
+    {
+        int n = MIN(seen[t], INFINITE_ADD);
+
+        for (i = 0; i < n && !full && added < INFINITE_ADD; i++)
+        {
+            if (!tagcache_retrieve(&tcs, pick[t][i], tag_filename, path,
+                                   sizeof(path)))
+                continue;
+            if (playlist_insert_track(NULL, path, PLAYLIST_INSERT_LAST,
+                                      false, false) < 0)
+            {
+                /* full: stop, each failure splashes for 2 s */
+                full = true;
+                break;
+            }
+            added++;
+#ifdef SIMULATOR
+            tagcache_retrieve(&tcs, pick[t][i], tag_title, genre, TAG_BUF);
+            fprintf(stderr, "pod: infinite pick %s\n", genre);
+#endif
+        }
+    }
+    tagcache_search_finish(&tcs);
+
+    if (added)
+    {
+        /* playlist_sync would post a flush to this very thread */
+        playlist_sync_control();
+#ifdef SIMULATOR
+        fprintf(stderr, "pod: infinite +%d\n", added);
+#endif
+    }
+    return added;
+}
