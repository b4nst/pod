+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#ifndef _POD_INFINITE_H
+#define _POD_INFINITE_H
+
+/* The menu item: Infinite play on or off, saved */
+int pod_infinite_toggle(void);
+char *pod_infinite_getname(int selected_item, void *data, char *buffer,
+                           size_t buffer_len);
+
+/* The queue has run out: append tracks picked by tags, by the tracks around
+   the last one (steps from the playing track, as playlist_peek takes them).
+   Returns how many were added, 0 when off or Repeat is on. Runs on the audio
+   thread. */
+int pod_infinite_extend(int last);
+
+#endif
