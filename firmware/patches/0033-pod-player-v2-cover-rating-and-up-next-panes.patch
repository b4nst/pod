+    pane_text(d, 2, POD_MID, buf);
+}
+
+/* Up next, read again only when the playlist or the list moved: it is drawn
+ * every 200 ms and a read looks the tagcache up, and wakes the disk. */
+static struct {
+    int here, top, amount;      /* what the rows were read for */
+    char rows[PANE_N][40];
+} next = { -1, -1, -1, { "" } };
+
+/* forget the rows: a new playlist can keep the same index and length */
+void pod_deck_next_reset(void)
+{
+    next.here = -1;
+}
+
+/* the path of the track `steps` after the playing one, as the list runs
+ * with Repeat off: Repeat one must not hold it on the playing track. The
+ * list starts at its first index, and wraps only with Repeat on, never
+ * past one round of the playlist. */
+bool pod_deck_next_path(int steps, char *path, size_t size)
+{
+    struct playlist_track_info info;
+    int cur, amount = playlist_amount();
+    int pos;
+
+    if (steps >= amount)
+        return false;
+    playlist_get_resume_info(&cur);
+    pos = (cur - playlist_get_first_index(NULL) + amount) % amount;
+    if (global_settings.repeat_mode == REPEAT_OFF && pos + steps >= amount)
+        return false;
+    if (playlist_get_track_info(NULL, (cur + steps) % amount, &info) < 0)
+        return false;
+    if (path)
+        strmemccpy(path, info.filename, size);
+    return true;
+}
+
+/* the tracks after the playing one, each "NN Title" */
+static void load_next(int top)
+{
+    struct tagcache_search tcs;
+    char path[MAX_PATH], title[MAX_PATH];
+
+    next.here = playlist_get_display_index() - 1;
+    next.top = top;
+    next.amount = playlist_amount();
+    for (int r = 0; r < PANE_N; r++)
+    {
+        next.rows[r][0] = '\0';
+        if (!pod_deck_next_path(top + 1 + r, path, sizeof(path)))
+            continue;
+        title[0] = '\0';
+        if (tagcache_find_index(&tcs, path))
+        {
+            tagcache_retrieve(&tcs, tcs.idx_id, tag_title, title,
+                              sizeof(title));
+            tagcache_search_finish(&tcs);
+        }
+        if (!title[0])
+            strmemccpy(title, strrchr(path, '/') ? strrchr(path, '/') + 1
+                                                 : path, sizeof(title));
+        snprintf(next.rows[r], sizeof(next.rows[r]), "%02d %.32s",
+                 (next.here + top + 1 + r) % MAX(1, next.amount) + 1, title);
+#ifdef SIMULATOR
+        if (r == 0)
+            fprintf(stderr, "pod: up next %s\n", title);
+#endif
+    }
+}
+
+/* Up next: "end of queue" past the last track */
+static void draw_play_next(struct screen *d, int top)
+{
+    if (next.here != playlist_get_display_index() - 1 || next.top != top
+        || next.amount != playlist_amount())
+        load_next(top);
+    if (!next.rows[0][0])
+        pane_text(d, 0, POD_MID, "end of queue");
+    for (int r = 0; r < PANE_N && next.rows[r][0]; r++)
+        pane_text(d, r, POD_INK, next.rows[r]);
+}
