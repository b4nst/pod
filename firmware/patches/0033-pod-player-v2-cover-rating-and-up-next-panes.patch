+/* a 30x17 cassette: the hubs' notches step every 200 ms of playback, and it
+ * is grey and still on pause */
+static void draw_play_cassette(struct screen *d, int x, int y,
+                               unsigned long elapsed, bool paused)
+{
+    static const signed char notch[8][2] = {
+        { 0, -3 }, { 2, -2 }, { 3, 0 }, { 2, 2 },
+        { 0, 3 }, { -2, 2 }, { -3, 0 }, { -2, -2 },
