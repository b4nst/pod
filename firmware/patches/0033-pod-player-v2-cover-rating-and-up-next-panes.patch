+/* Rating: five large stars in half steps, and how often it was played */
+static void draw_play_rating(struct screen *d, const struct mp3entry *id3)
+{
+    char buf[24];
+
+    for (int i = 0; i < 5; i++)
+        draw_star(d, PANE_X + i * STAR_BIG, PANE_Y + 2,
+                  id3->rating >= 2 * i + 2 ? 2 : id3->rating == 2 * i + 1 ? 1 : 0,
