+/* pod: PLAY plays the highlighted row in order, or shuffled for Shuffle All.
+ * A track plays from its place in the list (2). Anything else plays the
+ * tracks under it: an album, Songs, an artist by album. The root rows that
+ * are menus (Artists, Albums, Mixes, ...) are not playable (0). Returns 1
+ * when the row started playing, <0 on an error. */
+int tagtree_play_selection(struct tree_context *c, bool shuffle)
+{
+    int dirlevel = c->dirlevel;
+    int selected_item = c->selected_item;
+    bool root = c->currtable == TABLE_ROOT;
+    struct tagentry *e;
+    int rc = 0;
+
+    if (c->dirlength == 0)
+        return 0;
+
+    e = tagtree_get_entry(c, selected_item);
+    if (e->newtable == TABLE_PLAYTRACK)
+        return tagtree_play_folder(c, shuffle) < 0 ? -1 : 2;
+
+    if (e->customaction == ONPLAY_CUSTOMACTION_SHUFFLE_SONGS)
+        shuffle = true;
+    else if (e->customaction != ONPLAY_NO_CUSTOMACTION
+             || e->newtable != TABLE_NAVIBROWSE)
+        return 0;
+
+    tagtree_enter(c, false);
+    tagtree_load(c);
+    if (c->dirlength > 0 && tagtree_get_entry(c, 0)->newtable != TABLE_PLAYTRACK)
+    {
+        /* albums: all their tracks, as the [All tracks] row did */
+        if (root || c->dirlevel + 1 >= MAX_DIR_LEVELS
+            || c->currextra >= csi->tagorder_count - 1)
+            goto out;
+        table_history[c->dirlevel] = c->currtable;
+        extra_history[c->dirlevel] = c->currextra;
+        c->dirlevel++;
+        c->currtable = TABLE_ALLSUBENTRIES_SORTED_BY_ALBUMS;
+        csi->result_seek[c->currextra] = 0;
+        c->currextra++;
+        tagtree_load(c);
+    }
+    if (c->dirlength > 0)
+        rc = tagtree_play_folder(c, shuffle) < 0 ? -1 : 1;
+
+out:
+    reset_tc_to_prev(dirlevel, selected_item);
+    c->selected_item = selected_item;
+    loaded_entries_crc = 0;
+    return rc;
+}
+
 static struct tagentry* tagtree_get_entry(struct tree_context *c, int id)
 {
     struct tagentry *entry;
