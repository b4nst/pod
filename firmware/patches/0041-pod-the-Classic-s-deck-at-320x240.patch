+ ****************************************************************************/
+
+/* The header the Classic's screens share: a band, the title and four stripes
+ * that kick up to the right, as the theme draws them. */
+
+#include "config.h"
+#include "lcd.h"
+#include "screen_access.h"
+#include "pod_frame.h"
+
+const unsigned pod6_stripes[4] = {
+    LCD_RGBPACK(0xf7, 0xb5, 0x2c), LCD_RGBPACK(0xf2, 0x70, 0x1c),
+    LCD_RGBPACK(0xd9, 0x30, 0x2a), LCD_RGBPACK(0x7b, 0x1e, 0x3c),
+};
+
+void pod_frame_stripes(struct screen *d)
+{
+    for (int i = 0; i < 4; i++)
+    {
+        int top = 24 + 2*i;
+        d->set_foreground(POD6_STRIPE(i));
+        d->fillrect(0, top, 266, 2);
+        for (int k = 0; k <= top + 1; k++)
+            d->fillrect(266 + k, top - k, 1, 2);
+    }
+}
+
+void pod_frame_header(struct screen *d, const char *title, int font)
+{
+    d->set_foreground(POD6_BAND);
+    d->fillrect(0, 0, LCD_WIDTH, 24);
+    pod_frame_stripes(d);
+    d->set_foreground(POD6_AMBER);
+    d->setfont(font);
+    d->putsxy(8, 5, title);
+}
