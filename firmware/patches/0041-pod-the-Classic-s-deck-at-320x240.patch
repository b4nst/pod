-/* the panes: 2x2 dots, the current one inked */
+#else
+/* a 25x15 cassette, the mini's at twice the size, teal while it plays and
+ * grey and still on pause */
+static void draw_header_cassette(struct screen *d, int x, int y, bool paused)
+{
+    static const signed char notch[8][2] = {
+        { -2, -2 }, { 0, -2 }, { 2, -2 }, { 2, 0 },
+        { 2, 2 }, { 0, 2 }, { -2, 2 }, { -2, 0 },
+    };
+    int step = paused ? 0 : (current_tick / (HZ / 5)) % 8;
+
+    d->set_foreground(paused ? POD_MID : POD_TEAL);
+    d->drawrect(x, y, 25, 15);
+    d->hline(x + 6, x + 18, y + 11);
+    for (int h = 0; h < 2; h++)
+    {
+        int cx = x + 7 + h * 11, cy = y + 6;
+
+        d->fillrect(cx - 2, cy - 2, 5, 5);
+        d->set_foreground(POD_PAPER);
+        d->drawpixel(cx + notch[step][0], cy + notch[step][1]);
+        d->set_foreground(paused ? POD_MID : POD_TEAL);
+    }
