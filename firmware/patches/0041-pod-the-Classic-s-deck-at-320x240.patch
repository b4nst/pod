+#define LARGE_BYTES     (POD_COVER_LARGE * POD_COVER_LARGE * 2)
+#else
 #define LARGE_BYTES     (POD_COVER_LARGE / 4 * POD_COVER_LARGE)
+#endif
 
 struct slot {
     int rec;                    /* -1: free */
     bool bad;                   /* it could not be read */
     unsigned age;
-    unsigned char data[POD_COVER_BYTES];
+    fb_data data[POD_COVER_BYTES / sizeof(fb_data)];  /* aligned for d->bitmap */
 };
 
