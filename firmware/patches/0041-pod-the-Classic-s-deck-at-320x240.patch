+#ifndef _POD_FRAME_H_
+#define _POD_FRAME_H_
+
+#include "lcd.h"
+#include "screen_access.h"
+
+/* The Classic's autoreverse palette (see tools/mktheme6g.py) */
+#define POD6_PANEL      LCD_RGBPACK(0x0b, 0x0d, 0x14)
+#define POD6_BAND       LCD_RGBPACK(0x10, 0x13, 0x1c)
+#define POD6_RULE       LCD_RGBPACK(0x22, 0x28, 0x38)
+#define POD6_WELL       LCD_RGBPACK(0x12, 0x16, 0x22)
+#define POD6_TEXT       LCD_RGBPACK(0xed, 0xe3, 0xcf)
+#define POD6_TEXT2      LCD_RGBPACK(0xcf, 0xc6, 0xb3)
+#define POD6_TEXT3      LCD_RGBPACK(0x8c, 0x86, 0x78)
+#define POD6_OFF        LCD_RGBPACK(0x5b, 0x61, 0x72)
+#define POD6_AMBER      LCD_RGBPACK(0xff, 0xa5, 0x26)
+#define POD6_TEAL       LCD_RGBPACK(0x46, 0xdc, 0xc8)
+#define POD6_SEL0       LCD_RGBPACK(0x26, 0x2e, 0x42)
+#define POD6_STRIPE(i)  (pod6_stripes[i])
+
+extern const unsigned pod6_stripes[4];
+
+/* Four stripes under the header, kicking up to the right */
+void pod_frame_stripes(struct screen *d);
+
+/* The 24 px band with the title in amber, and the stripes under it */
+void pod_frame_header(struct screen *d, const char *title, int font);
+
+#endif /* _POD_FRAME_H_ */
