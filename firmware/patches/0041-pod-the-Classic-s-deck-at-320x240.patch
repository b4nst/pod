@@ -71,15 +79,8 @@ void pod_covers_load(void)
     cover_count = file_count = 0;
     for (int i = 0; i < SLOTS; i++)
         slots[i].rec = -1;
-#if LCD_DEPTH != 2
-    /* v2 records are 2-bit: on a 16-bit LCD d->bitmap would read past them */
-    if (fd >= 0) {
-        close(fd);
-        fd = -1;
-    }
-#endif
     if (fd >= 0 && read(fd, h, sizeof(h)) == sizeof(h) && !memcmp(h, "PODC", 4)
-        && le(h + 4, 2) == 2
+        && le(h + 4, 2) == POD_COVERS_VERSION
         && le(h + 6, 2) == POD_COVER_LARGE && le(h + 8, 2) == POD_COVER_LARGE
         && le(h + 10, 2) == POD_COVER_SMALL && le(h + 12, 2) == POD_COVER_SMALL)
     {
@@ -121,9 +122,9 @@ int pod_covers_find(uint32_t hash)
     return -1;
 }
 
-/* The 2 bpp covers of a record, read when first asked for, or
+/* The covers of a record, read when first asked for, or
  * NULL when the file can't give them */
-static const unsigned char *pod_covers_get(int rec)
+static const fb_data *pod_covers_get(int rec)
 {
     struct slot *s = &slots[0];
     bool ok = false;
@@ -160,7 +161,7 @@ static const unsigned char *pod_covers_get(int rec)
 
 bool pod_covers_draw_large(struct screen *d, int rec, int x, int y)
 {
-    const unsigned char *p = rec < 0 ? NULL : pod_covers_get(rec);
+    const fb_data *p = rec < 0 ? NULL : pod_covers_get(rec);
 
     if (p)
         d->bitmap(p, x, y, POD_COVER_LARGE, POD_COVER_LARGE);
@@ -169,9 +170,10 @@ bool pod_covers_draw_large(struct screen *d, int rec, int x, int y)
 
 bool pod_covers_draw_small(struct screen *d, int rec, int x, int y)
 {
-    const unsigned char *p = rec < 0 ? NULL : pod_covers_get(rec);
+    const fb_data *p = rec < 0 ? NULL : pod_covers_get(rec);
 
     if (p)
-        d->bitmap(p + LARGE_BYTES, x, y, POD_COVER_SMALL, POD_COVER_SMALL);
+        d->bitmap(p + LARGE_BYTES / sizeof(fb_data), x, y, POD_COVER_SMALL,
+                  POD_COVER_SMALL);
     return p != NULL;
 }
diff --git a/apps/gui/pod_covers.h b/apps/gui/pod_covers.h
