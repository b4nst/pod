diff --git a/bootloader/ipod.c b/bootloader/ipod.c
index 653169dade66bee373c2ff286de6841fc43f5d26..6054caaaeeded6b16aa1a0a99b0e87b3ed53151a 100644
--- a/bootloader/ipod.c
+++ b/bootloader/ipod.c
@@ -41,6 +41,7 @@
 #include "power.h"
 #include "file.h"
 #include "common.h"
+#include "bitmaps/rockboxlogo.h"
 #include "rb-loader.h"
 #include "loader_strerror.h"
 #include "hwcompat.h"
@@ -339,7 +340,19 @@ void* main(void)
 
     lcd_setfont(FONT_SYSFIXED);
 
-    printf("Rockbox boot loader");
+#if BMPHEIGHT_rockboxlogo == LCD_HEIGHT
+    /* pod: hold the splash from power on until the firmware draws its own.
+       The framebuffer is cleared again so that error messages start on a
+       blank screen; nothing reaches the LCD until the next update. */
+    if (!verbose)
+    {
+        lcd_bmp(&bm_rockboxlogo, 0, 0);
+        lcd_update();
+        lcd_clear_display();
+    }
+#endif
+
+    printf("pod boot loader");
     printf("Version: %s", rbversion);
     printf("IPOD version: 0x%08x", IPOD_HW_REVISION);
 
@@ -427,10 +440,10 @@ void* main(void)
             return (void*)DRAM_START;
         }
     } else {
-        printf("Loading Rockbox...");
+        printf("Loading pod...");
         rc=load_firmware(loadbuffer, BOOTFILE, MAX_LOADSIZE);
         if (rc > 0) {
-            printf("Rockbox loaded.");
+            printf("pod loaded.");
             return (void*)DRAM_START;
         } else if (rc == EFILE_NOT_FOUND) {
             /* if rockbox.ipod doesn't exist, then check if there is a Rockbox
