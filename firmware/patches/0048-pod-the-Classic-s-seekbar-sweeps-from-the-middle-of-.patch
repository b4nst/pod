+}
+
 static int bar_segment(const struct deck *k, int album)
 {
     return k->count > 1 ? (album * (BAR_N - 1) + (k->count - 1) / 2)
                           / (k->count - 1) : BAR_N - 1;
 }
 
-/* the first lit ticks, the rest faint */
+/* the first lit ticks, the rest faint. On the Classic a lit tick is the
+ * four stripes, yellow outside. */
 static void draw_ticks(struct screen *d, int lit)
 {
     for (int s = 0; s < BAR_N; s++)
     {
+#if LCD_WIDTH >= 320
+        if (s < lit)
+        {
+            for (int i = 0; i < 4; i++)
+            {
+                d->set_foreground(POD_HATCH(i));
+                bar_span(d, s, i * BAR_TICK_L / 4,
+                         (i + 1) * BAR_TICK_L / 4 - 1);
+            }
+            continue;
+        }
+#endif
         d->set_foreground(s < lit ? POD_AMBER : POD_UNLIT);
         bar_tick(d, s);
     }
 }
 
+#if LCD_WIDTH >= 320
+/* what the seekbar shows, under its foot: amber, or on amber while it is
