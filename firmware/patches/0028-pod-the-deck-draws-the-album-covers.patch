+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#ifndef _POD_COVERS_H_
+#define _POD_COVERS_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "screen_access.h"
+
+#define POD_COVER_LARGE 44
+#define POD_COVER_SMALL 28
+#define POD_COVER_BYTES 680     /* a 44x44 cover, then a 28x28 one: 2 bpp, 4 px a byte */
+
+/* Read the index of /.pod/covers.bin: none when it is missing or not ours */
+void pod_covers_load(void);
+
+/* The record of an album hash, or -1 */
+int pod_covers_find(uint32_t hash);
+
+/* Draw the large (44x44) or the small (28x28) cover of a record, false when
+ * there is none or the file can't give it */
+bool pod_covers_draw_large(struct screen *d, int rec, int x, int y);
+bool pod_covers_draw_small(struct screen *d, int rec, int x, int y);
+
+#endif /* _POD_COVERS_H_ */
