+#ifndef _POD_COVERS_H_
+#define _POD_COVERS_H_
+
+#include <stdint.h>
+
+#define POD_COVER_BYTES 647     /* a 38x59 card, then a 12x19 thumbnail */
+
+/* Read the index of /.pod/covers.bin: none when it is missing or not ours */
+void pod_covers_load(void);
+
+/* The record of an album hash, or -1 */
+int pod_covers_find(uint32_t hash);
+
+/* The 2 bpp card and thumbnail of a record, read when first asked for, or
+ * NULL when the file can't give them */
+const unsigned char *pod_covers_get(int rec);
+
+#endif /* _POD_COVERS_H_ */
