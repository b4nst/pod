     char artist[16];
+    int16_t cover;              /* its record in the covers, or -1 */
 };
 
 /* a mixtape is a deck_album with no tracks: start is -1 and end its index in
@@ -212,6 +214,7 @@ static bool queue_load(struct deck *k)
         k->count = n + 1;
         k->queue = true;
         q->start = q->end = -1;
+        q->cover = -1;
         strmemccpy(q->album, "Queue", sizeof(q->album));
     }
     snprintf(q->artist, sizeof(q->artist), "%d tracks", playlist_amount());
@@ -241,11 +244,13 @@ static bool load_albums(struct deck *k)
         a->end = k->count;
         strmemccpy(a->album, mixes[k->count].name, sizeof(a->album));
         a->artist[0] = '\0';
+        a->cover = -1;
     }
     if (total <= 0 || !tagcache_search(&tcs, tag_filename))
         return m > 0;
     total = MIN(total, DECK_MAX_TRACKS);
 
+    pod_covers_load();
     cpu_boost(true);
     while (k->track_count < total && tagcache_get_next(&tcs, path, sizeof(path)))
     {
@@ -279,6 +284,7 @@ static bool load_albums(struct deck *k)
         a = &k->albums[k->count++];
         a->start = i;
         a->end = i + 1;
+        a->cover = pod_covers_find(k->tracks[i].hash);
         get_tag(&tcs, k->tracks[i].idx, tag_album, album, sizeof(album));
         get_tag(&tcs, k->tracks[i].idx, tag_virt_canonicalartist, artist,
                 sizeof(artist));
@@ -735,6 +741,22 @@ static void draw_card(struct screen *d, int x, int y, int w, int h,
         draw_mix_card(d, x, y, w, h, t->album, tiny);
         return;
     }
+    if (t->cover >= 0)
+    {
+        const unsigned char *p = pod_covers_get(t->cover);
+
+        if (p)
+        {
+            /* native 2 bpp: the J-card, then the thumbnail */
+            if (w > THUMB_W)
+                d->bitmap(p, x, y, CARD_W, CARD_H);
+            else
+                d->bitmap(p + 590, x, y, THUMB_W, THUMB_H);
+            d->set_foreground(POD_INK);
+            d->drawrect(x, y, w, h);
+            return;
+        }
+    }
     d->set_foreground(POD_PAPER);
     d->fillrect(x, y, w, h);
     d->set_foreground(POD_FAINT);
