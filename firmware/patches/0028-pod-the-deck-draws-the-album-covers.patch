+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+
+/*
+ * The covers pod link syncs to /.pod/covers.bin: a sorted index of album
+ * hashes, then a record per hash. The index stays in RAM, the records are
+ * read when drawn and the last few kept, with no file open in between.
+ * Static buffers only, as the deck does (see pod_deck.c).
+ */
+
+#include "config.h"
+#include <stdio.h>
+#include <stdbool.h>
+#include <string.h>
+#include "system.h"
+#include "file.h"
+#include "rbpaths.h"
+#include "pod_covers.h"
+
+#define COVERS_FILE     ROCKBOX_DIR "/covers.bin"
+#define HEADER_BYTES    18
+#define COVERS_MAX      8192    /* as many as the deck has albums */
+#define SLOTS           16
+
+struct slot {
+    int rec;                    /* -1: free */
+    bool bad;                   /* it could not be read */
+    unsigned age;
+    unsigned char data[POD_COVER_BYTES];
+};
+
+static uint32_t cover_hash[COVERS_MAX];
+static int cover_count;         /* hashes kept */
+static int file_count;          /* records in the file */
+static struct slot slots[SLOTS];
+static unsigned tick;
+
+/* the header is not aligned */
+static uint32_t le(const unsigned char *p, int n)
+{
+    uint32_t v = 0;
+
+    while (n--)
+        v = v << 8 | p[n];
+    return v;
+}
+
+void pod_covers_load(void)
+{
+    unsigned char h[HEADER_BYTES];
+    int fd = open(COVERS_FILE, O_RDONLY);
+
+    cover_count = file_count = 0;
+    for (int i = 0; i < SLOTS; i++)
+        slots[i].rec = -1;
+    if (fd >= 0 && read(fd, h, sizeof(h)) == sizeof(h) && !memcmp(h, "PODC", 4)
+        && le(h + 4, 2) == 1
+        && le(h + 6, 2) == 38 && le(h + 8, 2) == 59
+        && le(h + 10, 2) == 12 && le(h + 12, 2) == 19)
+    {
+        uint32_t n = le(h + 14, 4);
+        int want = MIN(n, COVERS_MAX);
+
+        if (ffilesize(fd) >= (off_t)HEADER_BYTES
+                            + (off_t)n * (4 + POD_COVER_BYTES)
+            && read(fd, cover_hash, want * 4) == want * 4)
+        {
+            for (int i = 0; i < want; i++)
+                cover_hash[i] = letoh32(cover_hash[i]);
+            cover_count = want;
+            file_count = n;
+        }
+    }
+    if (fd >= 0)
+        close(fd);
+#ifdef SIMULATOR
+    fprintf(stderr, "pod: covers %d\n", cover_count);
+#endif
+}
+
+int pod_covers_find(uint32_t hash)
+{
+    int lo = 0, hi = cover_count - 1;
+
+    while (lo <= hi)
+    {
+        int mid = (lo + hi) / 2;
+
+        if (cover_hash[mid] == hash)
+            return mid;
+        if (cover_hash[mid] < hash)
+            lo = mid + 1;
+        else
+            hi = mid - 1;
+    }
+    return -1;
+}
+
+const unsigned char *pod_covers_get(int rec)
+{
+    struct slot *s = &slots[0];
+    bool ok = false;
+    int fd;
+
+    for (int i = 0; i < SLOTS; i++)
+        if (slots[i].rec == rec)
+        {
+            slots[i].age = ++tick;
+            return slots[i].bad ? NULL : slots[i].data;
+        }
+    for (int i = 1; i < SLOTS; i++)
+        if (slots[i].rec == -1 || (s->rec != -1 && slots[i].age < s->age))
+            s = &slots[i];
+
+    /* a record that can't be read is kept as bad, so it is not read again at
+     * each redraw */
+    fd = open(COVERS_FILE, O_RDONLY);
+    if (fd >= 0)
+    {
+        ok = lseek(fd, HEADER_BYTES + 4 * (off_t)file_count
+                       + (off_t)rec * POD_COVER_BYTES, SEEK_SET) >= 0
+             && read(fd, s->data, POD_COVER_BYTES) == POD_COVER_BYTES;
+        close(fd);
+    }
+#ifdef SIMULATOR
+    fprintf(stderr, "pod: cover read %d\n", rec);
+#endif
+    s->rec = rec;
+    s->age = ++tick;
+    s->bad = !ok;
+    return ok ? s->data : NULL;
+}
