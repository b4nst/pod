+    /* pod: without Apple firmware these boot pod, and disk mode is USB mode */
+    of_rc = rc;
+    rc = 0;
+
     lcd_init();
     lcd_set_foreground(LCD_WHITE);
     lcd_set_background(LCD_BLACK);
@@ -1037,9 +1061,20 @@ void main(void)
