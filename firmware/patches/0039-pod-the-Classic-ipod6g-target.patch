@@ -84,6 +85,22 @@
 #define LCD_REDORANGE   LCD_RGBPACK(255,70,0)
 #define LCD_GREEN       LCD_RGBPACK(0,255,0)
 
+/* pod: the splash, drawn from the packed 2-bit pixels of podlogo.h */
+static void draw_splash(void)
+{
+    static const unsigned char greys[] = { PODLOGO_GREYS };
+    int x0 = (LCD_WIDTH - PODLOGO_WIDTH) / 2;
+    int y0 = (LCD_HEIGHT - PODLOGO_HEIGHT) / 2;
+
+    for (int i = 0; i < PODLOGO_WIDTH * PODLOGO_HEIGHT; i++)
+    {
+        int g = greys[(podlogo[i / 4] >> (6 - 2 * (i % 4))) & 3];
+
+        lcd_set_foreground(LCD_RGBPACK(g, g, g));
+        lcd_drawpixel(x0 + i % PODLOGO_WIDTH, y0 + i / PODLOGO_WIDTH);
+    }
+}
+
