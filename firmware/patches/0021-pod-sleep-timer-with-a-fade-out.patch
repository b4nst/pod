diff --git a/apps/pod_sleep.c b/apps/pod_sleep.c
new file mode 100644
index 0000000000000000000000000000000000000000..60f715e48fd3d18dd3de712d514ebf07314919eb
--- /dev/null
+++ b/apps/pod_sleep.c
@@ -0,0 +1,196 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
+ * Copyright (C) 2026 banst
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This software is distributed on an "AS IS" basis, WITHOUT WARRANTY OF ANY
+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+/*
+ * The sleep timer: off, 15, 30, 60 minutes or the end of the playing album.
+ * The last 10 seconds fade out, then playback pauses and the volume is put
+ * back for the next play. The stock poweroff timer is not used: the idle
+ * poweroff turns the iPod off later, once it is paused.
+ */
+
+#include "config.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "system.h"
+#include "kernel.h"
+#include "audio.h"
+#include "backlight.h"
+#include "metadata.h"
+#include "pcm_mixer.h"
+#include "pcmbuf.h"
+#include "playlist.h"
+#include "settings.h"
+#include "pod_sleep.h"
+
+#define FADE_TICKS  (10 * HZ)
+
+enum { SLEEP_OFF, SLEEP_15, SLEEP_30, SLEEP_60, SLEEP_ALBUM, SLEEP_MODES };
+
+static const char * const names[SLEEP_MODES] =
+    { "Off", "15 min", "30 min", "60 min", "Album" };
+static const int minutes[SLEEP_MODES] = { 0, 15, 30, 60, 0 };
+
+static int mode = SLEEP_OFF;
+/* the pause, and the start of the fade when it is on */
+static long end_tick, fade_tick_start;
+static bool fading;
+/* when to put the volume back, after the pause has faded out */
+static long restore_tick;
+
+static void pod_sleep_fade_tick(void)
+{
+    long left = end_tick - current_tick;
+    long len = end_tick - fade_tick_start;
+    unsigned int r = left > 0 ? left * 256 / len : 0;
+
+    /* quadratic, so the end doesn't drop off */
+    pcmbuf_set_sleep_volume(r * r * (MIX_AMP_UNITY / (256 * 256)));
+}
+
+static void start_fade(long start)
+{
+    fade_tick_start = start;
+    fading = true;
+    tick_add_task(pod_sleep_fade_tick);
+#ifdef SIMULATOR
+    fprintf(stderr, "pod: sleep fade\n");
+#endif
+}
+
+static void stop_fade(void)
+{
+    if (fading)
+    {
+        tick_remove_task(pod_sleep_fade_tick);
+        fading = false;
+    }
+}
+
+int pod_sleep_cycle(void)
+{
+    long minute = HZ * 60;
+#ifdef SIMULATOR
+    if (getenv("POD_SLEEP_FAST"))
+        minute = HZ;
+#endif
+    stop_fade();
+    pcmbuf_set_sleep_volume(MIX_AMP_UNITY);
+    restore_tick = 0;
+    mode = (mode + 1) % SLEEP_MODES;
+    end_tick = current_tick + minutes[mode] * minute;
+    return 0;
+}
+
+char *pod_sleep_getname(int selected_item, void *data, char *buffer,
+                       size_t buffer_len)
+{
+    (void)selected_item;
+    (void)data;
+    snprintf(buffer, buffer_len, "Sleep: %s", names[mode]);
+    return buffer;
+}
+
+int pod_sleep_left(void)
+{
+    if (mode == SLEEP_OFF)
+        return POD_SLEEP_OFF;
+    if (mode == SLEEP_ALBUM && !fading)
+        return POD_SLEEP_ALBUM;
+    return MAX(0, (end_tick - current_tick) / HZ);
+}
+
+static bool is_album_end(struct mp3entry *id3)
+{
+    struct mp3entry *next;
+
+    if (global_settings.repeat_mode == REPEAT_ONE)
+        return true;
+    /* the last track, which Repeat All wraps from */
+    if (!playlist_peek(1, NULL, 0)
+        || playlist_get_display_index() == playlist_amount())
+        return true;
+    /* NULL: not buffered yet, look again at the next step */
+    next = audio_next_track();
+    if (!next)
+        return false;
+    return strcmp(id3->album ? id3->album : "", next->album ? next->album : "");
+}
+
+void pod_sleep_step(void)
+{
+    struct mp3entry *id3;
+    long rest;
+
+    /* early when played again, once the pause has faded out */
+    if (restore_tick && (TIME_AFTER(current_tick, restore_tick)
+                         || (audio_status() == AUDIO_STATUS_PLAY
+                             && TIME_AFTER(current_tick, restore_tick - HZ / 2))))
+    {
+        pcmbuf_set_sleep_volume(MIX_AMP_UNITY);
+        restore_tick = 0;
+    }
+
+    if (mode == SLEEP_OFF)
+        return;
+
+    if (audio_status() != AUDIO_STATUS_PLAY)
+    {
+        /* paused or stopped by hand: the timer is over */
+        if (fading)
+        {
+            stop_fade();
+            restore_tick = current_tick + HZ;
+            mode = SLEEP_OFF;
+        }
+        else if (mode != SLEEP_ALBUM && TIME_AFTER(current_tick, end_tick))
+            mode = SLEEP_OFF;
+        return;
+    }
+
+    if (mode == SLEEP_ALBUM && !fading)
+    {
+        id3 = audio_current_track();
+        rest = id3 ? (long)id3->length - (long)id3->elapsed : 0;
+
+        if (id3 && id3->length > 0 && rest <= 10000 && is_album_end(id3))
+        {
+            /* pause before the next album starts */
+            end_tick = current_tick + rest * HZ / 1000 - HZ / 2;
+            start_fade(current_tick);
+        }
+    }
+    else if (mode != SLEEP_ALBUM && !fading
+             && TIME_AFTER(current_tick, end_tick - FADE_TICKS))
+        start_fade(end_tick - FADE_TICKS);
+
+    if (mode != SLEEP_OFF && (mode != SLEEP_ALBUM || fading)
+        && TIME_AFTER(current_tick, end_tick))
+    {
+#ifdef SIMULATOR
+        id3 = audio_current_track();
+        fprintf(stderr, "pod: sleep pause %s\n", id3 && id3->title ? id3->title : "");
+#endif
+        audio_pause();
+        stop_fade();
+        restore_tick = current_tick + HZ;
+        mode = SLEEP_OFF;
+        backlight_off();
+    }
+}
