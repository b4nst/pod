+ * KIND, either express or implied.
+ *
+ ****************************************************************************/
+#ifndef _POD_SLEEP_H
+#define _POD_SLEEP_H
+
+/* The menu item: the next choice (off, 15, 30, 60 min, end of album), and
+   the timer starts again */
+int pod_sleep_cycle(void);
+char *pod_sleep_getname(int selected_item, void *data, char *buffer,
+                       size_t buffer_len);
+
+/* Seconds left, or POD_SLEEP_OFF, or POD_SLEEP_ALBUM for the end of the album
+   until its fade starts */
+#define POD_SLEEP_OFF   -1
+#define POD_SLEEP_ALBUM -2
+int pod_sleep_left(void);
+
+/* Stepped by the power thread */
+void pod_sleep_step(void);
+
+#endif
