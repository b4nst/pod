diff --git a/apps/pcmbuf.c b/apps/pcmbuf.c
index 3c68cfbf8440ea99f9cf0dd828393d734f8c2e5b..8f721f3a562ee25e033243784aadc67ed988a1ab 100644
--- a/apps/pcmbuf.c
+++ b/apps/pcmbuf.c
@@ -127,6 +127,8 @@ static bool pcmbuf_sync_position = false;
 
 /* Fade effect */
 static unsigned int fade_vol = MIX_AMP_UNITY;
+/* the sleep timer's fade, apart from fade_vol, which pause and stop own */
+static unsigned int sleep_vol = MIX_AMP_UNITY;
 static enum
 {
     PCM_NOT_FADING = 0,
@@ -1325,7 +1327,7 @@ int pcmbuf_descs(void)
 /* Sync the channel amplitude to all states */
 static void pcmbuf_update_volume(void)
 {
-    unsigned int vol = fade_vol;
+    unsigned int vol = (unsigned long long)fade_vol * sleep_vol / MIX_AMP_UNITY;
 
     if (soft_mode)
         vol >>= 2;
@@ -1410,6 +1412,21 @@ void pcmbuf_soft_mode(bool shhh)
 }
 
 
+/* Set the sleep timer's share of the channel volume */
+void pcmbuf_set_sleep_volume(unsigned int vol)
+{
+    /* Block the tick as in pcmbuf_soft_mode(), so a fade doesn't read the
+       old volume and update after us. */
+    int res = fade_state != PCM_NOT_FADING ?
+                tick_remove_task(pcmbuf_fade_tick) : -1;
+
+    sleep_vol = vol;
+    pcmbuf_update_volume();
+
+    if (res == 0)
+        tick_add_task(pcmbuf_fade_tick);
+}
+
 /** Time and position */
 
 /* Return the current position key value */
