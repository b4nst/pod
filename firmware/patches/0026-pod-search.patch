diff --git a/apps/gui/pod_search.c b/apps/gui/pod_search.c
new file mode 100644
index 0000000000000000000000000000000000000000..e5e47dd430542c0e0cce917ed40bb7127d22a8db
--- /dev/null
+++ b/apps/gui/pod_search.c
@@ -0,0 +1,494 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
