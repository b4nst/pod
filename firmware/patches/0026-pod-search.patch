+/* Put the deck on a pick of the search: the tape of an album, an artist's
+ * first album, or the album of a track, which plays from it. Returns whether
+ * a track plays. */
+static bool deck_pick(const struct deck *k, int *cur,
+                      const struct pod_search_pick *p)
+{
+    struct tagcache_search tcs;
+    char artist[MAX_PATH];
+    int album = find_album(k, p->idx);
+
+    if (p->kind == POD_PICK_ARTIST && tagcache_search(&tcs, tag_filename))
+    {
+        char name[sizeof(k->albums[0].artist)];
+
+        get_tag(&tcs, p->idx, tag_virt_canonicalartist, artist, sizeof(artist));
+        tagcache_search_finish(&tcs);
+        strmemccpy(name, artist, sizeof(name));
+        album = -1;
+        for (int a = 0; a < k->count && album < 0; a++)
+            if (!is_queue(&k->albums[a]) && !is_mix(&k->albums[a])
+                && !strcmp(k->albums[a].artist, name))
+                album = a;
+    }
+    if (album < 0)
+        return false;
+    *cur = album;
+    return p->kind == POD_PICK_TRACK && deck_play(k, album, p->idx);
+}
