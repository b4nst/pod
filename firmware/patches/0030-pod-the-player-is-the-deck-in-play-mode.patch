+/* ------------------------------------------------------------ play mode */
+
+/* slanted 7-segment digits for the counter: segments a-g are bits 0-6 */
+#define SEG_W           8
+#define SEG_H           14
+#define SEG_STEP        10
+#define SEG_MINUS       0x40
+#define VOLUME_SHOWN    (HZ * 3 / 2)    /* the volume, after a turn */
+#define REMAIN_X        52              /* the time left, SEEK */
+
+static const unsigned char seg_digits[10] = {
+    0x3f, 0x06, 0x5b, 0x4f, 0x66, 0x6d, 0x7d, 0x07, 0x7f, 0x6f,
+};
+
+/* the loved heart flashed over the tape, 11x10 in a 15x14 box */
+static const char heart_rows[10][12] = {
+    "..##...##..", ".####.####.", "###########", "###########",
+    "###########", ".#########.", "..#######..", "...#####...",
+    "....###....", ".....#.....",
+};
+
+/* The tape of the track playing: its album or mixtape on the deck, or one
+ * made from its tags when the deck doesn't have it. The deck is looked up
+ * again only when the track changes. */
+static const struct deck_album *play_tape(const struct mp3entry *id3,
+                                          struct deck_album *tags)
+{
+    if (strcmp(id3->path, play_path))
+    {
+        strmemccpy(play_path, id3->path, sizeof(play_path));
+        play_album = deck.albums ? playing_album(&deck) : -1;
+    }
+    if (play_album >= 0 && !is_queue(&deck.albums[play_album]))
+        return &deck.albums[play_album];
+    tags->start = tags->end = 0;
+    strmemccpy(tags->album, id3->album ? id3->album : UNTAGGED,
+               sizeof(tags->album));
+    strmemccpy(tags->artist, id3->albumartist ? id3->albumartist
+                             : id3->artist ? id3->artist : UNTAGGED,
+               sizeof(tags->artist));
+    tags->cover = pod_covers_find(hash_tags(tags->album, tags->artist));
+    return tags;
+}
+
+static bool volume_shown(void)
+{
+    return global_status.last_volume_change
+           && TIME_BEFORE(current_tick,
+                          global_status.last_volume_change + VOLUME_SHOWN);
+}
+
+/* The bargraph in play mode: a label per track of the queue, the playing
+ * one inverted, lit up to where it plays. After a turn of the wheel it is
+ * lit from the lowest volume to the volume. */
+static void draw_play_bargraph(struct screen *d, const struct mp3entry *id3,
+                               unsigned long elapsed, int font)
+{
+    int n = playlist_amount(), pos = playlist_get_display_index() - 1;
+    int frac = id3->length >= 1000 ? MIN(elapsed / (id3->length / 1000), 999) : 0;
+    int gap, cur_s, last_s;
+    char str[12];
+
+    if (n <= 0)
+        n = 1;
+    pos = MAX(0, MIN(pos, n - 1));
+    if (volume_shown())
+    {
+        int min = sound_min(SOUND_VOLUME), max = sound_max(SOUND_VOLUME);
+
+        draw_ticks(d, (global_status.volume - min) * BAR_N / MAX(1, max - min));
+    }
+    else
+        draw_ticks(d, (pos * 1000 + frac) * BAR_N / (n * 1000));
+
+    /* the widest number keeps the labels apart */
+    snprintf(str, sizeof(str), "%d", n);
+    gap = (text_width(font, str) + 3 + BAR_STEP - 1) / BAR_STEP;
+    cur_s = pos * BAR_N / n;
+    last_s = -gap;
+    d->setfont(font);
+    for (int i = 0; i < n; i++)
+    {
+        int s = i * BAR_N / n;
+
+        if (i != pos && (s - last_s < gap || abs(s - cur_s) < gap))
+            continue;
+        last_s = s;
+        snprintf(str, sizeof(str), "%d", i + 1);
+        draw_label(d, font, s, str, i == pos);
+    }
+}
+
+/* the big heart: filled after a love, an outline after an unlove */
+static void draw_heart(struct screen *d, int x, int y, bool hollow)
+{
+    d->set_foreground(POD_PAPER);
+    d->fillrect(x, y, 15, 14);
+    d->set_foreground(POD_INK);
+    for (int j = 0; j < 10; j++)
+        for (int i = 0; i < 11; i++)
+        {
+            bool edge;
+
+            if (heart_rows[j][i] != '#')
+                continue;
+            edge = i == 0 || i == 10 || j == 0 || j == 9
+                   || heart_rows[j][i - 1] != '#' || heart_rows[j][i + 1] != '#'
+                   || heart_rows[j - 1][i] != '#' || heart_rows[j + 1][i] != '#';
+            if (edge || !hollow)
+                d->drawpixel(x + 2 + i, y + 2 + j);
+        }
+}
+
+void pod_deck_draw_play(struct screen *d, struct viewport *vp)
+{
+    struct wps_state *state = get_wps_state();
+    struct mp3entry *id3 = state->id3;
+    struct viewport saved = *vp;
+    struct deck_album tags;
+    const struct deck_album *t;
+    unsigned long elapsed;
+
+    if (!id3)
+        return;
+    load_fonts();
+    elapsed = id3->elapsed + state->ff_rewind_count;
+    t = play_tape(id3, &tags);
+
+    d->set_background(POD_PAPER);
+    d->clear_viewport();
+    d->set_drawmode(DRMODE_FG);
+    draw_play_bargraph(d, id3, elapsed, f_tiny);
+    draw_status(d, f_tiny, true);
+    draw_card(d, CARD_X, CARD_Y, CARD_W, CARD_H, t, f_value, f_tiny);
+    /* the hubs turn every 200 ms of playback, so they stop on pause */
+    draw_tape(d, t, album_sub(&deck, t), f_tiny, (elapsed / 200) % 4,
+              id3->rating > 0);
+    if (state->love_flash)
+        draw_heart(d, TAPE_X + (TAPE_W - 15) / 2, TAPE_Y + 22,
+                   state->love_flash == 2);
+    *vp = saved;
+}
+
+/* the x of a row of a slanted digit: the top leans right */
+static int slant(int row)
+{
+    return (SEG_H - 1 - row) / 4;
+}
+
+/* a segment along rows r0-r1 from column c0 to c1 */
+static void seg_rows(struct screen *d, int x, int y, int r0, int r1, int c0,
+                     int c1)
+{
+    for (int r = r0; r <= r1; r++)
+        d->hline(x + slant(r) + c0, x + slant(r) + c1, y + r);
+}
+
+static void draw_digit(struct screen *d, int x, int y, unsigned segs)
+{
+    for (int k = 0; k < 7; k++)
+    {
+        if (!(segs & (1 << k)))
+            continue;
+        switch (k)
+        {
+        case 0: seg_rows(d, x, y, 0, 1, 2, SEG_W - 3); break;
+        case 1: seg_rows(d, x, y, 2, 5, SEG_W - 2, SEG_W - 1); break;
+        case 2: seg_rows(d, x, y, 8, 11, SEG_W - 2, SEG_W - 1); break;
+        case 3: seg_rows(d, x, y, 12, 13, 2, SEG_W - 3); break;
+        case 4: seg_rows(d, x, y, 8, 11, 0, 1); break;
+        case 5: seg_rows(d, x, y, 2, 5, 0, 1); break;
+        case 6: seg_rows(d, x, y, 6, 7, 2, SEG_W - 3); break;
+        }
+    }
+}
+
+/* digits, '-' and ':' in 7 segments. Returns the x after them. */
+static int draw_digits(struct screen *d, int x, int y, const char *s,
+                       unsigned fg)
+{
+    d->set_foreground(fg);
+    for (; *s; s++)
+    {
+        if (*s == ':')
+        {
+            d->fillrect(x + slant(4), y + 3, 2, 2);
+            d->fillrect(x + slant(10), y + 9, 2, 2);
+            x += 4;
+            continue;
+        }
+        draw_digit(d, x, y, *s == '-' ? SEG_MINUS : seg_digits[*s - '0']);
+        x += SEG_STEP;
+    }
+    return x;
+}
+
+void pod_deck_draw_counter(struct screen *d, struct viewport *vp)
+{
+    struct wps_state *state = get_wps_state();
+    struct mp3entry *id3 = state->id3;
+    struct viewport saved = *vp;
+    unsigned long elapsed, left;
+    char buf[24];
+    int x;
+
+    if (!id3)
+        return;
+    load_fonts();
+    elapsed = id3->elapsed + state->ff_rewind_count;
+    if (id3->length)
+        elapsed = MIN(elapsed, id3->length);
+    left = id3->length - elapsed;
+
+    d->set_background(POD_PAPER);
+    d->clear_viewport();
+    d->set_drawmode(DRMODE_FG);
+    d->setfont(f_tiny);
+    if (volume_shown())
+    {
+        int dec = sound_numdecimals(SOUND_VOLUME), val;
+
+        val = sound_val2phys(SOUND_VOLUME, global_status.volume);
+        while (dec-- > 0)
+            val /= 10;
+        snprintf(buf, sizeof(buf), "%d", val);
+        x = draw_digits(d, 1, 0, buf, POD_INK);
+        d->putsxy(x + 1, 8, "DB");
+    }
+    else
+    {
+        /* paused, the counter dims */
+        snprintf(buf, sizeof(buf), "%lu:%02lu", elapsed / 60000,
+                 elapsed / 1000 % 60);
+        draw_digits(d, 1, 0, buf, audio_status() & AUDIO_STATUS_PAUSE
+                                  ? POD_MID : POD_INK);
+        snprintf(buf, sizeof(buf), "-%lu:%02lu", left / 60000,
+                 left / 1000 % 60);
+        d->set_foreground(POD_MID);
+        d->putsxy(REMAIN_X, 1, buf);
+    }
+    if (state->scrubbing)
+    {
+        int th = font_get(f_tiny)->height;
+
+        d->set_foreground(POD_INK);
+        d->fillrect(REMAIN_X - 1, 8, text_width(f_tiny, "SEEK") + 2, th + 2);
+        d->set_foreground(POD_PAPER);
+        d->putsxy(REMAIN_X, 9, "SEEK");
+    }
+    *vp = saved;
+}
