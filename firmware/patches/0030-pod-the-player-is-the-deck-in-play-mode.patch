+/* a label inside the curve at the tick s, inverted when it is the current one */
+static void draw_label(struct screen *d, int font, int s, const char *str,
+                       bool current)
+{
+    int th = font_get(font)->height;
+    int w = text_width(font, str);
+    int x, y, ix, iy;
+
+    bar_pos(s, &x, &y, &ix, &iy);
+    x += BAR_LABEL * ix / 64 - w / 2;
+    y += BAR_LABEL * iy / 64 - th / 2;
+    if (current)
