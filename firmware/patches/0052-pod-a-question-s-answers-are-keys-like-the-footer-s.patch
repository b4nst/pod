 extern void splash_progress(int current, int total, const char *fmt, ...) ATTRIBUTE_PRINTF(3, 4);
+
+/*
+ * Puts a splash message centered on all the screens with a key and its
+ * answer on each of its last lines (pod: the yes/no question)
+ *  - count : how many keys
+ *  - keys, answers : the key names and what they do
+ *  - fmt : what to say *printf style
+ */
+extern void splash_keys(int count, const char * const *keys,
+                        const char * const *answers,
+                        const char *fmt, ...) ATTRIBUTE_PRINTF(4, 5);
 #endif /* _GUI_ICON_H_ */
