 #include "splash.h"
 #include "quickscreen.h"
 #include "shortcuts.h"
@@ -174,6 +175,60 @@ static const char* tree_get_filename(int selected_item, void *data,
     return(name);
 }
 
+static char tree_get_initial(int item)
+{
+    char buf[MAX_PATH];
+    unsigned char *name = (unsigned char *)tree_get_filename(item, &tc, buf,
+                                                              sizeof(buf));
+
+    /* in the database, a lang string comes back as a virtual pointer */
+    return name ? pod_letter_initial(P2STR(name)) : '#';
+}
+
+/* Select the first row of the next initial (dir > 0) or of the current one,
+ * the previous one when already on it (dir < 0). The ends stay put. */
+static void letter_jump(int dir)
+{
+    int first = tc.special_entry_count;
+    int count = gui_synclist_get_nb_items(&tree_lists);
+    int sel = gui_synclist_get_sel_pos(&tree_lists);
+    int i = sel;
+
+    if (count <= first)
+        return;
+    if (sel < first)
+    {
+        if (dir < 0)
+            return;
+        i = first;
+    }
+    else if (dir > 0)
+    {
+        char cur = tree_get_initial(sel);
+        while (++i < count && tree_get_initial(i) == cur)
+            ;
+        if (i == count)
+            return;
+    }
+    else
+    {
+        char cur = tree_get_initial(sel);
+        while (i > first && tree_get_initial(i - 1) == cur)
+            i--;
+        if (i == sel)
+        {
+            if (i == first)
+                return;
+            cur = tree_get_initial(--i);
+            while (i > first && tree_get_initial(i - 1) == cur)
+                i--;
+        }
+    }
+    gui_synclist_select_item(&tree_lists, i);
+    gui_synclist_draw(&tree_lists);
+    tc.selected_item = i;
+}
+
