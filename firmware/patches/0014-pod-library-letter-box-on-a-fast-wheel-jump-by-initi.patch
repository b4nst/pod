+/*
+ * The letter box shown over the library while the wheel spins fast or << >>
+ * jump by initial: a cassette label with the letter in Deck.
+ */
+
+#include "config.h"
+#include <stdbool.h>
+#include <ctype.h>
+#include "system.h"
+#include "rbpaths.h"
+#include "font.h"
+#include "screen_access.h"
+#include "pod_letter.h"
+
+#define FONT_LETTER     FONT_DIR "/40-Deck-Letter.fnt"
+
+#define BOX_SIZE    60
+#define BOX_FRAME   3       /* inset of the label's frame */
+
+char pod_letter_initial(const char *name)
+{
+    unsigned char c = name[0];
+
+    return (c < 0x80 && isalpha(c)) ? toupper(c) : '#';
+}
+
+void pod_letter_show(char c)
+{
+    static int font = -1;   /* loaded once, so a fast scroll doesn't read the disk */
+    struct screen *d = &screens[SCREEN_MAIN];
+    char s[2] = { c, '\0' };
+    int x = (LCD_WIDTH - BOX_SIZE) / 2;
+    int y = (LCD_HEIGHT - BOX_SIZE) / 2;
+    int w, h;
+
+    if (font < 0)
+    {
+        font = font_load(FONT_LETTER);
+        if (font < 0)
+            font = FONT_UI;
+    }
+
+    /* the selected row would scroll through the box */
+    d->scroll_stop();
+    d->set_viewport(NULL);
+    d->set_drawmode(DRMODE_SOLID);
+    d->set_foreground(LCD_BLACK);
+    d->fillrect(x, y, BOX_SIZE, BOX_SIZE);
+    d->set_foreground(LCD_LIGHTGRAY);
+    d->drawrect(x + BOX_FRAME, y + BOX_FRAME,
+                BOX_SIZE - 2*BOX_FRAME, BOX_SIZE - 2*BOX_FRAME);
+    d->set_foreground(LCD_WHITE);
+    d->setfont(font);
+    font_getstringsize(s, &w, &h, font);
+    d->set_drawmode(DRMODE_FG);
+    d->putsxy(x + (BOX_SIZE - w) / 2, y + (BOX_SIZE - h) / 2, s);
+    d->set_drawmode(DRMODE_SOLID);
+    d->setfont(FONT_UI);
+    d->set_foreground(LCD_DEFAULT_FG);
+    d->set_background(LCD_DEFAULT_BG);
+    d->update_rect(x, y, BOX_SIZE, BOX_SIZE);
+}
