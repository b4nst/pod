+            gui_synclist_draw(&tree_lists);
+        }
+        /* a fast wheel shows the initial of the row it lands on */
+        bool fast = false;
+#ifdef HAVE_WHEEL_ACCELERATION
+        if (button == ACTION_STD_NEXT || button == ACTION_STD_NEXTREPEAT ||
+            button == ACTION_STD_PREV || button == ACTION_STD_PREVREPEAT)
+            fast = button_apply_acceleration(get_action_data()) > 1;
+#endif
         gui_synclist_do_button(&tree_lists, &button);
         tc.selected_item = gui_synclist_get_sel_pos(&tree_lists);
+        if (fast && numentries)
+        {
+            pod_letter_show(tree_get_initial(tc.selected_item));
+            letter_until = current_tick + HZ*6/10;
+        }
         int customaction = ONPLAY_NO_CUSTOMACTION;
         bool do_restore_display = true;
         #ifdef HAVE_TAGCACHE
@@ -853,6 +927,15 @@ static int dirbrowse(void)
                 restore = do_restore_display;
                 break;
 
+            case ACTION_TREE_LETTER_PREV:
+            case ACTION_TREE_LETTER_NEXT:
+                if (numentries == 0)
+                    break;
+                letter_jump(button == ACTION_TREE_LETTER_NEXT ? 1 : -1);
+                pod_letter_show(tree_get_initial(tc.selected_item));
+                letter_until = current_tick + HZ*6/10;
+                break;
+
             case ACTION_TREE_STOP:
                 if (list_stop_handler())
                     restore = do_restore_display;
