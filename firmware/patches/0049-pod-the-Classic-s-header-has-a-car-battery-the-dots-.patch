-    d->fillrect(x + 23, 10, 2, 4);
-    d->set_foreground(POD_FAINT);
-    d->fillrect(x + 2, 8, 19, 8);
-    d->set_foreground(POD_TEAL);
-    for (int i = 0; i < (MIN(level, 100) * 5 + 99) / 100; i++)
-        d->fillrect(x + 2 + i * 4, 8, 3, 8);
+    x -= 6 + BATT_W;
+    draw_battery(d, x, 7, level);
+    x -= 6 + 5;
     if (button_hold())
