                          && !(status & AUDIO_STATUS_PAUSE));
+    if (n > 1)
+        draw_dots(d, dots, pane, n);
+    x = dots - 8;
     if (pod_sleep_left() != POD_SLEEP_OFF)
     {
         const char *z = sleep_text(buf, sizeof(buf));
 
-        x -= 6 + text_width(font, z);
-        d->set_foreground(POD_TEAL);
