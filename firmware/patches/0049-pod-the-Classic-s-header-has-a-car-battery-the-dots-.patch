+/* The battery, a car battery of 15x11: its outline and terminals in grey,
+ * and four cells inside filling up, amber on the last one. mktheme6g.py
+ * draws the same for the lists. */
+#define BATT_W          15
+static void draw_battery(struct screen *d, int x, int y, int level)
+{
+    static const char battery[11][16] = {
+        "..##.......##..", "..##.......##..", "###############",
+        "#.............#", "#.............#", "#.............#",
+        "#.............#", "#.............#", "#.............#",
+        "#.............#", "###############",
+    };
+    int cells = level < 0 ? 0 : level < 25 ? 1 : level < 50 ? 2
+                : level < 75 ? 3 : 4;
+
+    d->set_foreground(POD_MID);
+    for (int j = 0; j < 11; j++)
+        for (int i = 0; i < BATT_W; i++)
+            if (battery[j][i] == '#')
+                d->drawpixel(x + i, y + j);
+    for (int i = 0; i < 4; i++)
+    {
+        d->set_foreground(i >= cells ? POD_FAINT : cells == 1 ? POD_AMBER
+                          : POD_UV);
+        d->fillrect(x + 2 + 3 * i, y + 4, 2, 5);
+    }
+}
+
+/* the play modes that are on, as small ultraviolet tags ending at x:
+ * shuffled, Repeat all or one, Infinite. Returns the x before them, and
+ * leaves out those that would go left of min. */
+static int draw_mode_tags(struct screen *d, int font, int x, int min)
