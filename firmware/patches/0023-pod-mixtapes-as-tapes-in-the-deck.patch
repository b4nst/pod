  ****************************************************************************/
 /*
  * Mixes: the playlists pod link syncs to /Mixes (one /Music/... path per
- * line). The library's Mixes row lists them and SELECT plays one.
+ * line). The deck shows them as tapes, ahead of the albums. A line
+ * "#RULE:<text>" is what the mix is made of, shown on its tape.
  */
 
 #include "config.h"
 #include <stdio.h>
 #include <string.h>
 #include "string-extra.h"
-#include "action.h"
 #include "dir.h"
 #include "file.h"
 #include "filetree.h"
-#include "list.h"
+#include "misc.h"
 #include "pathfuncs.h"
-#include "icon.h"
-#include "root_menu.h"
-#include "settings.h"
-#include "tree.h"
+#include "playlist.h"
 #include "pod_mixes.h"
 
-/* mixes are *.m3u8 (or *.m3u) files, whatever else is in the directory */
-static int count_mixes(void)
+#define RULE_TAG        "#RULE:"
+#define RULE_LINES      4       /* the rule is one of the first lines */
+
+static bool is_mix_file(const char *name)
+{
+    const char *ext = strrchr(name, '.');
+    return ext && (!strcasecmp(ext, ".m3u8") || !strcasecmp(ext, ".m3u"));
+}
+
+/* the text of the rule line at the top of a mix, or empty */
+static void read_rule(const char *path, char *rule, int size)
+{
+    char line[MAX_PATH];
+    int fd = open(path, O_RDONLY);
+
+    *rule = '\0';
+    if (fd < 0)
+        return;
+    for (int i = 0; i < RULE_LINES && read_line(fd, line, sizeof(line)) > 0; i++)
+        if (!strncmp(line, RULE_TAG, strlen(RULE_TAG)))
+        {
+            strmemccpy(rule, line + strlen(RULE_TAG), size);
+            break;
+        }
+    close(fd);
+}
+
+static int cmp_mix(const void *a, const void *b)
+{
+    const struct pod_mix *x = a, *y = b;
+    return strcasecmp(x->name, y->name);
+}
+
+int pod_mixes_load(struct pod_mix *m, int max)
 {
     int count = 0;
     DIR *dir = opendir(POD_MIXES_DIR);
+    struct dirent *entry;
+
     if (!dir)
         return 0;
-    struct dirent *entry;
-    while ((entry = readdir(dir)))
+    while (count < max && (entry = readdir(dir)))
     {
-        const char *ext = strrchr(entry->d_name, '.');
-        if (ext && (!strcasecmp(ext, ".m3u8") || !strcasecmp(ext, ".m3u")))
-            count++;
+        char path[MAX_PATH];
+        char *ext;
+
+        if (!is_mix_file(entry->d_name))
+            continue;
+        strmemccpy(m[count].file, entry->d_name, sizeof(m[count].file));
+        strmemccpy(m[count].name, entry->d_name, sizeof(m[count].name));
+        ext = strrchr(m[count].name, '.');
+        if (ext)
+            *ext = '\0';
+        snprintf(path, sizeof(path), POD_MIXES_DIR "/%s", entry->d_name);
+        read_rule(path, m[count].rule, sizeof(m[count].rule));
+        count++;
     }
     closedir(dir);
+    qsort(m, count, sizeof(struct pod_mix), cmp_mix);
     return count;
 }
 
-int pod_mixes(void)
+bool pod_mixes_play(const struct pod_mix *m)
 {
-    int count = count_mixes();
-#ifdef SIMULATOR
-    fprintf(stderr, "pod: mixes %d\n", count);
-#endif
-    if (count == 0)
-    {
-        struct simplelist_info info;
-        simplelist_info_init(&info, "Mixes", 1, NULL);
-        simplelist_reset_lines();
-        simplelist_addline("Sync with pod link to get mixes");
-        simplelist_show_list(&info);
-        return GO_TO_PREVIOUS;
-    }
-
     char path[MAX_PATH];
-    struct browse_context browse = {
-        .dirfilter = SHOW_M3U,
-        .flags = BROWSE_SELECTONLY | BROWSE_NO_CONTEXT_MENU,
-        .title = "Mixes",
-        .icon = Icon_Playlist,
-        .root = POD_MIXES_DIR,
-        .buf = path,
-        .bufsize = sizeof(path),
-    };
-    int rc = rockbox_browse(&browse);
-    if (!(browse.flags & BROWSE_SELECTED))
-        return rc;
+    char dir[] = POD_MIXES_DIR;
 
+    snprintf(path, sizeof(path), POD_MIXES_DIR "/%s", m->file);
+    if (!file_exists(path))
+        return false;
 #ifdef SIMULATOR
-    fprintf(stderr, "pod: mix %s\n", path);
+    fprintf(stderr, "pod: deck play mix %s\n", path);
 #endif
-    char dir[MAX_PATH];
-    strmemccpy(dir, path, sizeof(dir));
-    char *file = strrchr(dir, PATH_SEPCH);
-    *file++ = '\0';
-    ft_play_playlist(path, dir, file);
-    return GO_TO_WPS;
+    return ft_play_playlist(path, dir, m->file);
+}
+
+int pod_mixes_find(const struct pod_mix *m, int count)
+{
+    char buf[MAX_PATH], path[MAX_PATH];
+    const char *playing = playlist_get_name(NULL, buf, sizeof(buf));
+
+    if (!playing)
+        return -1;
+    for (int i = 0; i < count; i++)
+    {
+        snprintf(path, sizeof(path), POD_MIXES_DIR "/%s", m[i].file);
+        if (!strcmp(path, playing))
+            return i;
+    }
+    return -1;
 }
diff --git a/apps/pod_mixes.h b/apps/pod_mixes.h
