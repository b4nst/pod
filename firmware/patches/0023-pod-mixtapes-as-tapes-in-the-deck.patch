@@ -20,9 +20,9 @@
 
 /*
  * The cassette deck, browse mode: one tape per album (an artist's and
- * another's of the same name are two), a bargraph with the initials round
- * the corner, the J-card and the tape of the current album, and a rack of
- * the next ones below.
+ * another's of the same name are two), after a tape per mix of /Mixes, a
+ * bargraph with the initials round the corner, the J-card and the tape of
+ * the current album, and a rack of the next ones below.
  *
  * On entry the albums are read from the tagcache: a row per track (album,
  * artist, disc, track) sorted by album, so an album is a run of rows that is
@@ -55,6 +55,7 @@
 #include "tagcache.h"
 #include "lang.h"
 #include "pod_letter.h"
+#include "pod_mixes.h"
 #include "pod_sleep.h"
 #include "pod_deck.h"
 
@@ -112,6 +113,8 @@ struct deck_album {
     char artist[16];
 };
 
+/* a mixtape is a deck_album with no tracks: start is -1 and end its index in
+ * the mixes. They come first, under the # initial. */
 #define DECK_MAX_TRACKS 32768   /* 384 KB, a CF card full of music */
 #define DECK_MAX_ALBUMS 8192    /* 384 KB */
 
@@ -119,11 +122,14 @@ struct deck {
     struct deck_track *tracks;
     int track_count;
     struct deck_album *albums;
-    int count;                  /* albums */
+    int count;                  /* albums and mixtapes */
+    struct pod_mix *mixes;
+    int mix_count;              /* the first of them */
 };
 
 static struct deck_track rows[DECK_MAX_TRACKS];
 static struct deck_album shelf[DECK_MAX_ALBUMS];
+static struct pod_mix mixes[POD_MIXES_MAX];
 
 /* cos of 0, 11.25, ... 90 degrees in 64ths: the corner of the bargraph */
 static const unsigned char corner_cos[BAR_A] = { 64, 63, 59, 53, 45, 36, 24, 12, 0 };
@@ -173,20 +179,37 @@ static void get_tag(struct tagcache_search *tcs, int32_t idx, int tag,
         strmemccpy(buf, UNTAGGED, size);
 }
 
-/* Read the albums. Returns false when the library is busy or empty. */
+static bool is_mix(const struct deck_album *a)
+{
+    return a->start < 0;
+}
+
+/* Read the mixtapes and the albums. Returns false when there are none. */
 static bool deck_load(struct deck *k)
 {
     struct tagcache_search tcs;
     char path[MAX_PATH], album[MAX_PATH], artist[MAX_PATH];
     int total = tagcache_get_stat()->total_entries;
     bool full = total > DECK_MAX_TRACKS;
+    int m = pod_mixes_load(mixes, POD_MIXES_MAX);
 
-    k->count = k->track_count = 0;
-    if (total <= 0 || !tagcache_search(&tcs, tag_filename))
-        return false;
-    total = MIN(total, DECK_MAX_TRACKS);
+    k->track_count = 0;
+    k->mixes = mixes;
+    k->mix_count = m;
     k->tracks = rows;
     k->albums = shelf;
+    for (k->count = 0; k->count < m; k->count++)
+    {
+        struct deck_album *a = &shelf[k->count];
+
+        a->start = -1;
+        a->end = k->count;
+        strmemccpy(a->album, mixes[k->count].name, sizeof(a->album));
+        a->artist[0] = '\0';
+    }
+    if (total <= 0 || !tagcache_search(&tcs, tag_filename))
+        return m > 0;
+    total = MIN(total, DECK_MAX_TRACKS);
 
     cpu_boost(true);
     while (k->track_count < total && tagcache_get_next(&tcs, path, sizeof(path)))
@@ -230,7 +253,7 @@ static bool deck_load(struct deck *k)
     tagcache_search_finish(&tcs);
     cpu_boost(false);
 
-    qsort(k->albums, k->count, sizeof(struct deck_album), cmp_album);
+    qsort(k->albums + m, k->count - m, sizeof(struct deck_album), cmp_album);
     if (full)
         splash(HZ * 2, "Library too big: some albums are left out");
     return k->count > 0;
@@ -243,27 +266,43 @@ static const struct deck_album *album_row(const struct deck *k, int album)
 
 static char album_initial(const struct deck *k, int album)
 {
-    return pod_letter_initial(album_row(k, album)->album);
+    const struct deck_album *a = album_row(k, album);
+
+    return is_mix(a) ? '#' : pod_letter_initial(a->album);
+}
+
+/* the second line of a tape: the artist, or what a mix is made of */
+static const char *album_sub(const struct deck *k, const struct deck_album *a)
+{
+    return is_mix(a) ? k->mixes[a->end].rule : a->artist;
 }
 
 /* the album a tagcache track belongs to, or -1 */
 static int find_album(const struct deck *k, int32_t idx)
 {
     for (int a = 0; a < k->count; a++)
+    {
+        if (is_mix(&k->albums[a]))
+            continue;
         for (int i = k->albums[a].start; i < k->albums[a].end; i++)
             if (k->tracks[i].idx == idx)
                 return a;
+    }
     return -1;
 }
 
-/* the album of the track the playlist is on: the player may still be
- * loading it, so ask the playlist and not the audio thread */
+/* the album or mixtape of the track the playlist is on: the player may still
+ * be loading it, so ask the playlist and not the audio thread */
 static int playing_album(const struct deck *k)
 {
     struct tagcache_search tcs;
     char buf[MAX_PATH];
-    const char *path = playlist_peek(0, buf, sizeof(buf));
-    int album = -1;
+    const char *path;
+    int album = pod_mixes_find(k->mixes, k->mix_count);
+
+    if (album >= 0)
+        return album;
+    path = playlist_peek(0, buf, sizeof(buf));
 
     if (path && tagcache_find_index(&tcs, path))
     {
@@ -299,6 +338,8 @@ static bool deck_play(const struct deck *k, int album)
     struct tagcache_search tcs;
     char path[MAX_PATH];
 
+    if (is_mix(&k->albums[album]))
+        return pod_mixes_play(&k->mixes[k->albums[album].end]);
     if (!tagcache_search(&tcs, tag_filename))
     {
         splash(HZ, ID2P(LANG_TAGCACHE_BUSY));
@@ -449,14 +490,71 @@ static void draw_bargraph(struct screen *d, const struct deck *k, int cur,
     }
 }
 
+/* the name of a mixtape in upper case on up to two lines of a label, cut at
+ * the last space that fits */
+static void card_name(struct screen *d, int font, int x, int y, int w,
+                      const char *s)
+{
+    char buf[sizeof(((struct deck_album *)0)->album)], line[sizeof(buf)];
+    const char *p = buf;
+    int th = font_get(font)->height;
+
+    for (int n = 0; (buf[n] = toupper((unsigned char)s[n])); n++)
+        ;
+    d->setfont(font);
+    for (int row = 0; row < 2 && *p; row++)
+    {
+        int n = strlen(p);
+
+        strmemccpy(line, p, sizeof(line));
+        while (n > 0 && text_width(font, line) > w)
+            line[--n] = '\0';
+        if (row == 0 && p[n])
+            for (int i = n; i > 0; i--)
+                if (line[i - 1] == ' ')
+                {
+                    n = i;
+                    line[n] = '\0';
+                    break;
+                }
+        d->putsxy(x, y + row * (th + 4), line);
+        for (p += n; *p == ' '; p++)
+            ;
+    }
+}
+
+/* A mixtape card: ruled lines like a label to write on, and the name on the
+ * first ones. A thumbnail has the lines only. */
+static void draw_mix_card(struct screen *d, int x, int y, int w, int h,
+                          const char *name, int font)
+{
+    bool thumb = w <= THUMB_W;
+    int step = thumb ? 4 : 10;
+
+    d->set_foreground(POD_PAPER);
+    d->fillrect(x, y, w, h);
+    d->set_foreground(POD_FAINT);
+    for (int j = thumb ? 5 : 17; j < h - 3; j += step)
+        d->hline(x + 2, x + w - 3, y + j);
+    d->set_foreground(POD_INK);
+    d->drawrect(x, y, w, h);
+    if (!thumb)
+        card_name(d, font, x + 3, y + 17 - font_get(font)->height - 1, w - 6, name);
+}
+
 /* A generated card: a hatch picked by the album, and its initial. Both the
  * J-card and the thumbnails come through here. */
 static void draw_card(struct screen *d, int x, int y, int w, int h,
-                      const struct deck_album *t, int font)
+                      const struct deck_album *t, int font, int tiny)
 {
     unsigned pattern = hash_tags(t->album, t->artist) % 4;
     char str[2] = { pod_letter_initial(t->album), '\0' };
 
+    if (is_mix(t))
+    {
+        draw_mix_card(d, x, y, w, h, t->album, tiny);
+        return;
+    }
     d->set_foreground(POD_PAPER);
     d->fillrect(x, y, w, h);
     d->set_foreground(POD_FAINT);
@@ -518,7 +616,8 @@ static void draw_hub(struct screen *d, int cx, int cy)
     d->fillrect(cx - 1, cy - 1, 3, 3);
 }
 
-static void draw_tape(struct screen *d, const struct deck_album *t, int font)
+static void draw_tape(struct screen *d, const struct deck_album *t,
+                      const char *sub, int font)
 {
     int x = TAPE_X, y = TAPE_Y, r = x + TAPE_W - 1, b = y + TAPE_H - 1;
 
@@ -535,12 +634,12 @@ static void draw_tape(struct screen *d, const struct deck_album *t, int font)
     d->drawpixel(x + 1, b - 1);
     d->drawpixel(r - 1, b - 1);
 
-    /* label: album and artist */
+    /* label: album and artist, or mixtape and rule */
     d->drawrect(x + 3, y + 3, TAPE_W - 6, 16);
     d->setfont(font);
     tape_text(d, font, x + 6, y + 5, t->album);
     d->set_foreground(POD_MID);
-    tape_text(d, font, x + 6, y + 12, t->artist);
+    tape_text(d, font, x + 6, y + 12, sub);
 
     /* the hubs, joined by the tape along their bottoms */
     draw_hub(d, x + 20, y + 29);
@@ -567,7 +666,7 @@ static void draw_rack(struct screen *d, const struct deck *k, int cur, int font)
             a = i;          /* nothing before the first: start with it */
         if (a < 0 || a >= k->count)
             continue;
-        draw_card(d, x, THUMB_Y, THUMB_W, THUMB_H, album_row(k, a), font);
+        draw_card(d, x, THUMB_Y, THUMB_W, THUMB_H, album_row(k, a), font, font);
         if (a == cur)
         {
             d->set_foreground(POD_INK);
@@ -620,8 +719,8 @@ static void draw(struct screen *d, const struct deck *k, int cur, int f_value,
 
     draw_bargraph(d, k, cur, f_tiny);
     draw_status(d, f_tiny);
-    draw_card(d, CARD_X, CARD_Y, CARD_W, CARD_H, t, f_value);
-    draw_tape(d, t, f_tiny);
+    draw_card(d, CARD_X, CARD_Y, CARD_W, CARD_H, t, f_value, f_tiny);
+    draw_tape(d, t, album_sub(k, t), f_tiny);
     draw_rack(d, k, cur, f_tiny);
 
     d->setfont(FONT_UI);
