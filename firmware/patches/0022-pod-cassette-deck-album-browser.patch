+/*
+ * The cassette deck, browse mode: one tape per album (an artist's and
+ * another's of the same name are two), a bargraph with the initials round
+ * the corner, the J-card and the tape of the current album, and a rack of
+ * the next ones below.
+ *
+ * On entry the albums are read from the tagcache: a row per track (album,
+ * artist, disc, track) sorted by album, so an album is a run of rows that is
+ * already in play order. The rows are static, and so are the fonts once
+ * loaded: allocating from buflib while a track plays makes the player stop
+ * and resume it.
+ */
+
+#include "config.h"
+#include <stdio.h>
+#include <stdbool.h>
+#include <string.h>
+#include <ctype.h>
+#include <stdlib.h>
+#include "string-extra.h"
+#include "system.h"
+#include "kernel.h"
+#include "action.h"
+#include "settings.h"
+#include "rbpaths.h"
+#include "font.h"
+#include "screen_access.h"
+#include "viewport.h"
+#include "misc.h"
+#include "audio.h"
+#include "playlist.h"
+#include "powermgmt.h"
+#include "splash.h"
+#include "root_menu.h"
+#include "tagcache.h"
+#include "lang.h"
+#include "pod_letter.h"
+#include "pod_sleep.h"
+#include "pod_deck.h"
+
+#define FONT_VALUE      FONT_DIR "/14-Deck-Bold.fnt"
+#define FONT_TINY       FONT_DIR "/06-Tiny.fnt"
+
+/* light theme: dark ink on the bare (backlit) panel */
+#define POD_PAPER       LCD_WHITE
+#define POD_FAINT       LCD_LIGHTGRAY
+#define POD_MID         LCD_DARKGRAY
+#define POD_INK         LCD_BLACK
+
+/* bargraph: ticks every 4 px up the left edge, round a 20 px corner and
+ * across the top. A tick is 2 px along the path and 6 across. */
+#define BAR_STEP        4
+#define BAR_X           3       /* the vertical run */
+#define BAR_Y0          55      /* its lowest tick */
+#define BAR_R           20      /* corner radius, its centre at (R+3, R+3) */
+#define BAR_TOP         3       /* the horizontal run */
+#define BAR_XEND        111     /* before the battery */
+#define BAR_V           8       /* ticks of the vertical run */
+#define BAR_A           9       /* ticks of the corner */
+#define BAR_H           22      /* ticks of the horizontal run */
+#define BAR_N           (BAR_V + BAR_A + BAR_H)
+#define BAR_LABEL       9       /* labels sit this far inside the ticks */
+#define LABEL_GAP       2       /* ticks: 8 px between two labels */
+
+/* J-card, tape and rack */
+#define CARD_X          17
+#define CARD_Y          19
+#define CARD_W          38
+#define CARD_H          59
+#define TAPE_X          60
+#define TAPE_Y          19
+#define TAPE_W          74
+#define TAPE_H          46
+#define THUMB_W         12
+#define THUMB_H         19
+#define THUMB_X         3
+#define THUMB_Y         86
+#define THUMB_STEP      15
+#define THUMB_N         9       /* the previous album, the current one, 7 more */
+
+/* a track: the album it belongs to is told by a hash of the whole album and
+ * artist, the text is only kept for the albums */
+struct deck_track {
+    uint32_t hash;
+    int32_t idx;                /* tagcache index of the track */
+    uint16_t disc, track;
+};
+
+struct deck_album {
+    int start, end;             /* its tracks, in play order */
+    char album[24];             /* to sort and to show */
+    char artist[16];
+};
+
+#define DECK_MAX_TRACKS 32768   /* 384 KB, a CF card full of music */
+#define DECK_MAX_ALBUMS 8192    /* 384 KB */
+
+struct deck {
+    struct deck_track *tracks;
+    int track_count;
+    struct deck_album *albums;
+    int count;                  /* albums */
+};
+
+static struct deck_track rows[DECK_MAX_TRACKS];
+static struct deck_album shelf[DECK_MAX_ALBUMS];
+
+/* cos of 0, 11.25, ... 90 degrees in 64ths: the corner of the bargraph */
+static const unsigned char corner_cos[BAR_A] = { 64, 63, 59, 53, 45, 36, 24, 12, 0 };
+
+static int cmp_track(const void *a, const void *b)
+{
+    const struct deck_track *x = a, *y = b;
+
+    if (x->hash != y->hash)
+        return x->hash < y->hash ? -1 : 1;
+    if (x->disc != y->disc)
+        return x->disc - y->disc;
+    if (x->track != y->track)
+        return x->track - y->track;
+    return x->idx - y->idx;
+}
+
+static int cmp_album(const void *a, const void *b)
+{
+    const struct deck_album *x = a, *y = b;
+    int d = strcasecmp(x->album, y->album);
+
+    if (!d)
+        d = strcasecmp(x->artist, y->artist);
+    return d ? d : x->start - y->start;
+}
+
+/* FNV-1a over the album, a separator and the artist, case folded as the
+ * sorting is */
+static uint32_t hash_tags(const char *album, const char *artist)
+{
+    uint32_t h = 2166136261u;
+
+    for (const char *p = album; *p; p++)
+        h = (h ^ (unsigned char)tolower((unsigned char)*p)) * 16777619u;
+    h *= 16777619u;
+    for (const char *p = artist; *p; p++)
+        h = (h ^ (unsigned char)tolower((unsigned char)*p)) * 16777619u;
+    return h;
+}
+
+/* the tag of a track, or <Untagged> */
+static void get_tag(struct tagcache_search *tcs, int32_t idx, int tag,
+                    char *buf, long size)
+{
+    if (!tagcache_retrieve(tcs, idx, tag, buf, size) || !*buf)
+        strmemccpy(buf, UNTAGGED, size);
+}
+
+/* Read the albums. Returns false when the library is busy or empty. */
+static bool deck_load(struct deck *k)
+{
+    struct tagcache_search tcs;
+    char path[MAX_PATH], album[MAX_PATH], artist[MAX_PATH];
+    int total = tagcache_get_stat()->total_entries;
+    bool full = total > DECK_MAX_TRACKS;
+
+    k->count = k->track_count = 0;
+    if (total <= 0 || !tagcache_search(&tcs, tag_filename))
+        return false;
+    total = MIN(total, DECK_MAX_TRACKS);
+    k->tracks = rows;
+    k->albums = shelf;
+
+    cpu_boost(true);
+    while (k->track_count < total && tagcache_get_next(&tcs, path, sizeof(path)))
+    {
+        struct deck_track *t = &k->tracks[k->track_count++];
+
+        t->idx = tcs.idx_id;
+        get_tag(&tcs, t->idx, tag_album, album, sizeof(album));
+        get_tag(&tcs, t->idx, tag_virt_canonicalartist, artist, sizeof(artist));
+        t->hash = hash_tags(album, artist);
+        t->disc = MAX(0, tagcache_get_numeric(&tcs, tag_discnumber));
+        t->track = MAX(0, tagcache_get_numeric(&tcs, tag_tracknumber));
+    }
+
+    /* an album is a run of one hash, already in play order */
+    qsort(k->tracks, k->track_count, sizeof(struct deck_track), cmp_track);
+    for (int i = 0; i < k->track_count; i++)
+    {
+        struct deck_album *a;
+
+        if (i > 0 && k->tracks[i - 1].hash == k->tracks[i].hash)
+        {
+            k->albums[k->count - 1].end = i + 1;
+            continue;
+        }
+        if (k->count == DECK_MAX_ALBUMS)
+        {
+            full = true;
+            k->track_count = i;
+            break;
+        }
+        a = &k->albums[k->count++];
+        a->start = i;
+        a->end = i + 1;
+        get_tag(&tcs, k->tracks[i].idx, tag_album, album, sizeof(album));
+        get_tag(&tcs, k->tracks[i].idx, tag_virt_canonicalartist, artist,
+                sizeof(artist));
+        strmemccpy(a->album, album, sizeof(a->album));
+        strmemccpy(a->artist, artist, sizeof(a->artist));
+    }
+    tagcache_search_finish(&tcs);
+    cpu_boost(false);
+
+    qsort(k->albums, k->count, sizeof(struct deck_album), cmp_album);
+    if (full)
+        splash(HZ * 2, "Library too big: some albums are left out");
+    return k->count > 0;
+}
+
+static const struct deck_album *album_row(const struct deck *k, int album)
+{
+    return &k->albums[album];
+}
+
+static char album_initial(const struct deck *k, int album)
+{
+    return pod_letter_initial(album_row(k, album)->album);
+}
+
+/* the album a tagcache track belongs to, or -1 */
+static int find_album(const struct deck *k, int32_t idx)
+{
+    for (int a = 0; a < k->count; a++)
+        for (int i = k->albums[a].start; i < k->albums[a].end; i++)
+            if (k->tracks[i].idx == idx)
+                return a;
+    return -1;
+}
+
+/* the album of the track the playlist is on: the player may still be
+ * loading it, so ask the playlist and not the audio thread */
+static int playing_album(const struct deck *k)
+{
+    struct tagcache_search tcs;
+    char buf[MAX_PATH];
+    const char *path = playlist_peek(0, buf, sizeof(buf));
+    int album = -1;
+
+    if (path && tagcache_find_index(&tcs, path))
+    {
+        album = find_album(k, tcs.idx_id);
+        tagcache_search_finish(&tcs);
+    }
+    return album;
+}
+
+/* the first album of the previous / next initial */
+static int jump_letter(const struct deck *k, int cur, int dir)
+{
+    char c = album_initial(k, cur);
+    int a = cur;
+
+    if (dir > 0)
+    {
+        while (a < k->count - 1 && album_initial(k, a) == c)
+            a++;
+        return a;
+    }
+    while (a > 0 && album_initial(k, a) == c)
+        a--;
+    c = album_initial(k, a);
+    while (a > 0 && album_initial(k, a - 1) == c)
+        a--;
+    return a;
+}
+
+/* Put the tracks of an album on a new playlist and start it. */
+static bool deck_play(const struct deck *k, int album)
+{
+    struct tagcache_search tcs;
+    char path[MAX_PATH];
+
+    if (!tagcache_search(&tcs, tag_filename))
+    {
+        splash(HZ, ID2P(LANG_TAGCACHE_BUSY));
+        return false;
+    }
+    if (playlist_create(NULL, NULL) < 0)
+    {
+        tagcache_search_finish(&tcs);
+        return false;
+    }
+    for (int i = k->albums[album].start; i < k->albums[album].end; i++)
+        if (tagcache_retrieve(&tcs, k->tracks[i].idx, tag_filename, path,
+                              sizeof(path)))
+            playlist_insert_track(NULL, path, PLAYLIST_INSERT_LAST, false, false);
+    tagcache_search_finish(&tcs);
+    playlist_sync(NULL);
+    playlist_start(0, 0, 0);
+    return true;
+}
+
+static int load_font(const char *path)
+{
+    int id = font_load(path);
+    return id < 0 ? FONT_SYSFIXED : id;
+}
+
+static int text_width(int font, const char *s)
+{
+    int w, h;
+    font_getstringsize(s, &w, &h, font);
+    return w;
+}
+
+/* a filled disc, for the hubs */
+static void disc(struct screen *d, int cx, int cy, int r)
+{
+    for (int dy = -r; dy <= r; dy++)
+    {
+        int dx = 0;
+        while ((dx + 1) * (dx + 1) + dy * dy <= r * r + r)
+            dx++;
+        d->hline(cx - dx, cx + dx, cy + dy);
+    }
+}
+
+/* The tick s of the bargraph: its centre, and the direction inside the curve
+ * in 64ths */
+static void bar_pos(int s, int *x, int *y, int *ix, int *iy)
+{
+    if (s < BAR_V)
+    {
+        *x = BAR_X;
+        *y = BAR_Y0 - s * BAR_STEP;
+        *ix = 64;
+        *iy = 0;
+    }
+    else if (s < BAR_V + BAR_A)
+    {
+        int k = s - BAR_V;
+        *ix = corner_cos[k];
+        *iy = corner_cos[BAR_A - 1 - k];
+        *x = BAR_X + BAR_R - BAR_R * *ix / 64;
+        *y = BAR_TOP + BAR_R - BAR_R * *iy / 64;
+    }
+    else
+    {
+        *x = BAR_X + BAR_R + (s - BAR_V - BAR_A + 1) * BAR_STEP;
+        *y = BAR_TOP;
+        *ix = 0;
+        *iy = 64;
+    }
+}
+
+static void bar_tick(struct screen *d, int s)
+{
+    int x, y, ix, iy;
+
+    bar_pos(s, &x, &y, &ix, &iy);
+    if (s < BAR_V)
+        d->fillrect(x - 3, y - 1, 6, 2);
+    else if (s >= BAR_V + BAR_A)
+        d->fillrect(x - 1, y - 3, 2, 6);
+    else
+    {
+        int x0 = x - 3 * ix / 64, y0 = y - 3 * iy / 64;
+        int x1 = x + 3 * ix / 64, y1 = y + 3 * iy / 64;
+        /* two px wide: shift by one across the steeper axis */
+        d->drawline(x0, y0, x1, y1);
+        d->drawline(x0 + (ix < iy), y0 + (ix >= iy), x1 + (ix < iy),
+                    y1 + (ix >= iy));
+    }
+}
+
+static int bar_segment(const struct deck *k, int album)
+{
+    return k->count > 1 ? (album * (BAR_N - 1) + (k->count - 1) / 2)
+                          / (k->count - 1) : BAR_N - 1;
+}
+
+static void draw_bargraph(struct screen *d, const struct deck *k, int cur,
+                          int font)
+{
+    int th = font_get(font)->height;
+    int lit = bar_segment(k, cur);
+    char curc = album_initial(k, cur);
+    int cur_s = 0, last_s = -LABEL_GAP;
+
+    for (int s = 0; s < BAR_N; s++)
+    {
+        d->set_foreground(s <= lit ? POD_INK : POD_FAINT);
+        bar_tick(d, s);
+    }
+
+    /* a letter at the first album of each initial; the current one is
+     * inverted and always there */
+    for (int a = 0; a < k->count; a++)
+        if (a == 0 || album_initial(k, a - 1) != album_initial(k, a))
+            if (album_initial(k, a) == curc)
+                cur_s = bar_segment(k, a);
+    d->setfont(font);
+    for (int a = 0; a < k->count; a++)
+    {
+        char c = album_initial(k, a);
+        char str[2] = { c, '\0' };
+        int s = bar_segment(k, a), x, y, ix, iy;
+        bool current = c == curc;
+
+        if (a > 0 && album_initial(k, a - 1) == c)
+            continue;
+        if (!current && (s - last_s < LABEL_GAP || abs(s - cur_s) < LABEL_GAP))
+            continue;
+        last_s = s;
+        bar_pos(s, &x, &y, &ix, &iy);
+        x += BAR_LABEL * ix / 64;
+        y += BAR_LABEL * iy / 64;
+        int w = text_width(font, str);
+        x -= w / 2;
+        y -= th / 2;
+        if (current)
+        {
+            d->set_foreground(POD_INK);
+            d->fillrect(x - 1, y - 1, w + 2, th + 2);
+            d->set_foreground(POD_PAPER);
+        }
+        else
+            d->set_foreground(POD_MID);
+        d->putsxy(x, y, str);
+    }
+}
+
+/* A generated card: a hatch picked by the album, and its initial. Both the
+ * J-card and the thumbnails come through here. */
+static void draw_card(struct screen *d, int x, int y, int w, int h,
+                      const struct deck_album *t, int font)
+{
+    unsigned pattern = hash_tags(t->album, t->artist) % 4;
+    char str[2] = { pod_letter_initial(t->album), '\0' };
+
+    d->set_foreground(POD_PAPER);
+    d->fillrect(x, y, w, h);
+    d->set_foreground(POD_FAINT);
+    for (int j = 1; j < h - 1; j++)
+        for (int i = 1; i < w - 1; i++)
+            if ((pattern == 0 && (i + j) % 4 == 0)
+                || (pattern == 1 && (i - j + 64) % 4 == 0)
+                || (pattern == 2 && j % 3 == 0)
+                || (pattern == 3 && i % 3 == 0 && j % 2 == 0))
+                d->drawpixel(x + i, y + j);
+    d->set_foreground(POD_INK);
+    d->drawrect(x, y, w, h);
+
+    int tw = text_width(font, str), th = font_get(font)->height;
+    if (w > THUMB_W)
+    {
+        /* the J-card: the initial on a label */
+        int lw = tw + 8, lh = th + 4;
+        d->set_foreground(POD_PAPER);
+        d->fillrect(x + (w - lw) / 2, y + 10, lw, lh);
+        d->set_foreground(POD_INK);
+        d->drawrect(x + (w - lw) / 2, y + 10, lw, lh);
+    }
+    d->setfont(font);
+    d->putsxy(x + (w - tw) / 2, w > THUMB_W ? y + 12 : y + (h - th) / 2, str);
+}
+
+/* the album and artist, upper case, cut to fit the label */
+static void tape_text(struct screen *d, int font, int x, int y, const char *s)
+{
+    char buf[34];
+    int n = 0;
+
+    while (s[n] && n < (int)sizeof(buf) - 1)
+    {
+        buf[n] = toupper((unsigned char)s[n]);
+        n++;
+    }
+    buf[n] = '\0';
+    while (n > 0 && text_width(font, buf) > TAPE_W - 14)
+        buf[--n] = '\0';
+    d->putsxy(x, y, buf);
+}
+
+static void draw_hub(struct screen *d, int cx, int cy)
+{
+    d->set_foreground(POD_INK);
+    disc(d, cx, cy, 8);
+    d->set_foreground(POD_PAPER);
+    disc(d, cx, cy, 5);
+    /* six teeth */
+    d->set_foreground(POD_INK);
+    d->drawpixel(cx - 4, cy);
+    d->drawpixel(cx + 4, cy);
+    d->drawpixel(cx - 2, cy - 3);
+    d->drawpixel(cx + 2, cy - 3);
+    d->drawpixel(cx - 2, cy + 3);
+    d->drawpixel(cx + 2, cy + 3);
+    d->fillrect(cx - 1, cy - 1, 3, 3);
+}
+
+static void draw_tape(struct screen *d, const struct deck_album *t, int font)
+{
+    int x = TAPE_X, y = TAPE_Y, r = x + TAPE_W - 1, b = y + TAPE_H - 1;
+
+    /* shell with the corners cut */
+    d->set_foreground(POD_PAPER);
+    d->fillrect(x, y, TAPE_W, TAPE_H);
+    d->set_foreground(POD_INK);
+    d->hline(x + 2, r - 2, y);
+    d->hline(x + 2, r - 2, b);
+    d->vline(x, y + 2, b - 2);
+    d->vline(r, y + 2, b - 2);
+    d->drawpixel(x + 1, y + 1);
+    d->drawpixel(r - 1, y + 1);
+    d->drawpixel(x + 1, b - 1);
+    d->drawpixel(r - 1, b - 1);
+
+    /* label: album and artist */
+    d->drawrect(x + 3, y + 3, TAPE_W - 6, 16);
+    d->setfont(font);
+    tape_text(d, font, x + 6, y + 5, t->album);
+    d->set_foreground(POD_MID);
+    tape_text(d, font, x + 6, y + 12, t->artist);
+
+    /* the hubs, joined by the tape along their bottoms */
+    draw_hub(d, x + 20, y + 29);
+    draw_hub(d, r - 20, y + 29);
+    d->set_foreground(POD_INK);
+    d->hline(x + 20, r - 20, y + 38);
+
+    /* bottom ridge */
+    d->hline(x + 12, r - 12, b - 3);
+    d->drawpixel(x + 11, b - 2);
+    d->drawpixel(r - 11, b - 2);
+    d->vline(x + 22, b - 2, b - 1);
+    d->vline(r - 22, b - 2, b - 1);
+}
+
+static void draw_rack(struct screen *d, const struct deck *k, int cur, int font)
+{
+    for (int i = 0; i < THUMB_N; i++)
+    {
+        int a = cur - 1 + i;
+        int x = THUMB_X + i * THUMB_STEP;
+
+        if (cur == 0)
+            a = i;          /* nothing before the first: start with it */
+        if (a < 0 || a >= k->count)
+            continue;
+        draw_card(d, x, THUMB_Y, THUMB_W, THUMB_H, album_row(k, a), font);
+        if (a == cur)
+        {
+            d->set_foreground(POD_INK);
+            d->drawrect(x - 1, THUMB_Y - 1, THUMB_W + 2, THUMB_H + 2);
+            d->fillrect(x + 4, THUMB_Y - 5, 4, 3);
+        }
+    }
+}
+
+static void draw_status(struct screen *d, int font)
+{
+    int level = battery_level();
+    int status = audio_status();
+
+    /* battery */
+    d->set_foreground(POD_INK);
+    d->drawrect(117, 1, 17, 7);
+    d->fillrect(134, 3, 2, 3);
+    if (level > 0)
+        d->fillrect(119, 3, MIN(level, 100) * 13 / 100, 3);
+
+    /* the sleep timer is set */
+    d->setfont(font);
+    if (pod_sleep_left() != POD_SLEEP_OFF)
+        d->putsxy(117, 10, "Z");
+
+    /* playing or paused */
+    if (status & AUDIO_STATUS_PLAY)
+    {
+        if (status & AUDIO_STATUS_PAUSE)
+        {
+            d->fillrect(126, 10, 2, 7);
+            d->fillrect(130, 10, 2, 7);
+        }
+        else
+            for (int i = 0; i < 4; i++)
+                d->vline(126 + i, 10 + i, 16 - i);
+    }
+}
+
+static void draw(struct screen *d, const struct deck *k, int cur, int f_value,
+                 int f_tiny)
+{
+    const struct deck_album *t = album_row(k, cur);
+
+    d->set_background(POD_PAPER);
+    d->clear_display();
+    /* text goes over filled shapes, so never paint glyph backgrounds */
+    d->set_drawmode(DRMODE_FG);
+
+    draw_bargraph(d, k, cur, f_tiny);
+    draw_status(d, f_tiny);
+    draw_card(d, CARD_X, CARD_Y, CARD_W, CARD_H, t, f_value);
+    draw_tape(d, t, f_tiny);
+    draw_rack(d, k, cur, f_tiny);
+
+    d->setfont(FONT_UI);
+    d->set_drawmode(DRMODE_SOLID);
+    d->set_foreground(LCD_DEFAULT_FG);
+    d->set_background(LCD_DEFAULT_BG);
+    d->update();
+}
+
+int pod_deck(bool on_playing)
+{
+    struct screen *d = &screens[SCREEN_MAIN];
+    struct deck k;
+    static int f_value = -1, f_tiny = -1;   /* loaded once */
+    int cur = 0, ret = GO_TO_PREVIOUS;
+
+    if (!deck_load(&k))
+    {
+        splash(HZ, ID2P(LANG_NO_FILES));
+        return GO_TO_PREVIOUS;
+    }
+    if (on_playing)
+        cur = MAX(0, playing_album(&k));
+
+    if (f_value < 0)
+    {
+        f_value = load_font(FONT_VALUE);
+        f_tiny = load_font(FONT_TINY);
+    }
+    FOR_NB_SCREENS(i)
+        viewportmanager_theme_enable(i, false, NULL);
+    d->set_viewport(NULL);
+
+    while (true)
+    {
+#ifdef SIMULATOR
+        fprintf(stderr, "pod: deck %d/%d %s\n", cur + 1, k.count,
+                album_row(&k, cur)->album);
+#endif
+        draw(d, &k, cur, f_value, f_tiny);
+
+        int button = get_action(CONTEXT_POD_DECK, TIMEOUT_BLOCK);
+
+        switch (button)
+        {
+        case ACTION_STD_NEXT:
+        case ACTION_STD_NEXTREPEAT:
+            cur = MIN(cur + 1, k.count - 1);
+            break;
+        case ACTION_STD_PREV:
+        case ACTION_STD_PREVREPEAT:
+            cur = MAX(cur - 1, 0);
+            break;
+        case ACTION_TREE_LETTER_NEXT:
+            cur = jump_letter(&k, cur, 1);
+            break;
+        case ACTION_TREE_LETTER_PREV:
+            cur = jump_letter(&k, cur, -1);
+            break;
+        case ACTION_STD_OK:
+        case ACTION_TREE_WPS:
+#ifdef SIMULATOR
+            fprintf(stderr, "pod: deck play %s\n", album_row(&k, cur)->album);
+#endif
+            if (deck_play(&k, cur))
+            {
+                /* PLAY plays in order; a second tap within the window
+                 * shuffles the rest, the track stays */
+                long until = current_tick + HZ * 3 / 10;
+
+                while (button == ACTION_TREE_WPS
+                       && TIME_BEFORE(current_tick, until))
+                {
+                    button = get_action(CONTEXT_POD_DECK, until - current_tick);
+                    if (button == ACTION_TREE_SHUFFLE
+                        || button == ACTION_TREE_WPS)
+                    {
+#ifdef SIMULATOR
+                        fprintf(stderr, "pod: play shuffled\n");
+#endif
+                        playlist_randomise(NULL, current_tick, true);
+                        break;
+                    }
+                }
+                ret = GO_TO_WPS;
+                goto done;
+            }
+            break;
+        case ACTION_STD_CANCEL:
+            goto done;
+        case ACTION_STD_MENU:
+            ret = GO_TO_MAINMENU;
+            goto done;
+        default:
+            if (default_event_handler(button) == SYS_USB_CONNECTED)
+                goto done;
+            break;
+        }
+    }
+
+done:
+    FOR_NB_SCREENS(i)
+        viewportmanager_theme_undo(i, false);
+    return ret;
+}
