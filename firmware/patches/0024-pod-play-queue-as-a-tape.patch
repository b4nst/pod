 static int load_font(const char *path)
 {
     int id = font_load(path);
@@ -542,6 +654,28 @@ static void draw_mix_card(struct screen *d, int x, int y, int w, int h,
         card_name(d, font, x + 3, y + 17 - font_get(font)->height - 1, w - 6, name);
 }
 
+/* The queue card: a tracklist, with the playing mark on the first line. A
+ * thumbnail has three lines. */
+static void draw_queue_card(struct screen *d, int x, int y, int w, int h)
+{
+    bool thumb = w <= THUMB_W;
+    int step = thumb ? 5 : 7;
+
+    d->set_foreground(POD_PAPER);
+    d->fillrect(x, y, w, h);
+    d->set_foreground(POD_FAINT);
+    for (int n = 0; n < (thumb ? 3 : 8); n++)
+        d->hline(x + (thumb ? 2 : 9), x + w - 3, y + (thumb ? 4 : 6) + n * step);
+    if (!thumb)
+    {
+        d->set_foreground(POD_INK);
+        for (int i = 0; i < 4; i++)
+            d->vline(x + 3 + i, y + 3 + i, y + 9 - i);
+    }
+    d->set_foreground(POD_INK);
+    d->drawrect(x, y, w, h);
+}
+
 /* A generated card: a hatch picked by the album, and its initial. Both the
  * J-card and the thumbnails come through here. */
 static void draw_card(struct screen *d, int x, int y, int w, int h,
@@ -550,6 +684,11 @@ static void draw_card(struct screen *d, int x, int y, int w, int h,
     unsigned pattern = hash_tags(t->album, t->artist) % 4;
