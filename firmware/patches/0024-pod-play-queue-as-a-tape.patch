 }
 
+/* Add an album or a mixtape to the playlist, after the playing track or at
+ * the end. With nothing to add to it plays them. */
+static bool deck_insert(const struct deck *k, int album, int position)
+{
+    struct tagcache_search tcs;
+    char path[MAX_PATH];
+
+    if (playlist_amount() <= 0)
+        return deck_play(k, album);
+    if (is_mix(&k->albums[album]))
+    {
+        snprintf(path, sizeof(path), POD_MIXES_DIR "/%s",
+                 k->mixes[k->albums[album].end].file);
+        if (playlist_insert_playlist(NULL, path, position, false) < 0)
+            return false;
+        playlist_sync(NULL);
+        return true;
+    }
+    if (!tagcache_search(&tcs, tag_filename))
+    {
+        splash(HZ, ID2P(LANG_TAGCACHE_BUSY));
+        return false;
+    }
+    for (int i = k->albums[album].start; i < k->albums[album].end; i++)
+        if (tagcache_retrieve(&tcs, k->tracks[i].idx, tag_filename, path,
+                              sizeof(path)))
+        {
+            playlist_insert_track(NULL, path, position, false, false);
+            /* the rest follow the first, in order */
+            if (position == PLAYLIST_INSERT_FIRST)
+                position = PLAYLIST_INSERT;
+        }
+    tagcache_search_finish(&tcs);
+    /* inserted tracks are not buffered unless the audio thread reloads */
+    if (audio_status() & AUDIO_STATUS_PLAY)
+        audio_flush_and_reload_tracks();
+    playlist_sync(NULL);
+    return true;
+}
+
+/* The hold SELECT menu of an album: Play next or Play last. Returns whether
+ * it was added. */
+static bool deck_insert_menu(const struct deck *k, int album)
+{
+    MENUITEM_STRINGLIST(menu, ID2P(LANG_PLAYLIST), NULL,
+                        ID2P(LANG_PLAY_NEXT), ID2P(LANG_PLAY_LAST));
+    int sel;
+    bool next, added;
+
+    FOR_NB_SCREENS(i)
+        viewportmanager_theme_undo(i, false);
+    sel = do_menu(&menu, NULL, NULL, false);
+    FOR_NB_SCREENS(i)
+        viewportmanager_theme_enable(i, false, NULL);
+    screens[SCREEN_MAIN].set_viewport(NULL);
+    if (sel != 0 && sel != 1)
+        return false;
+    next = sel == 0;
+#ifdef SIMULATOR
+    fprintf(stderr, "pod: deck insert %s %s\n", next ? "next" : "last",
+            album_row(k, album)->album);
+#endif
+    added = deck_insert(k, album, next ? PLAYLIST_INSERT_FIRST
+                                       : PLAYLIST_INSERT_LAST);
+    if (added)
+        splash(HZ, next ? ID2P(LANG_PLAY_NEXT) : ID2P(LANG_PLAY_LAST));
+    return added;
+}
