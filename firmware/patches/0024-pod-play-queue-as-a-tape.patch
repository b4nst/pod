+static bool is_queue(const struct deck_album *a)
+{
+    return a->start < 0 && a->end < 0;
+}
+
 static bool is_mix(const struct deck_album *a)
 {
-    return a->start < 0;
+    return a->start < 0 && a->end >= 0;
+}
+
+/* Put the queue ahead of the tapes when there is a current playlist, whether
+ * it plays or waits to resume, or keep its track count up to date. Returns
+ * whether there is one. */
+static bool queue_load(struct deck *k)
+{
+    struct deck_album *q = &shelf[0];
+
+    if (playlist_amount() <= 0
+        && (global_status.resume_index == -1 || playlist_resume() == -1))
+        return k->queue;
+    if (!k->queue)
+    {
+        int n = MIN(k->count, DECK_MAX_ALBUMS - 1);
+
+        memmove(&shelf[1], &shelf[0], n * sizeof(shelf[0]));
+        k->count = n + 1;
+        k->queue = true;
+        q->start = q->end = -1;
+        strmemccpy(q->album, "Queue", sizeof(q->album));
+    }
+    snprintf(q->artist, sizeof(q->artist), "%d tracks", playlist_amount());
+    return true;
 }
 
 /* Read the mixtapes and the albums. Returns false when there are none. */
