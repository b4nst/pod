         t->secs = MIN(65535, MAX(0, tagcache_get_numeric(&tcs, tag_length)) / 1000);
@@ -453,7 +499,19 @@ static bool load_albums(struct deck *k)
 
         if (i > 0 && k->tracks[i - 1].hash == k->tracks[i].hash)
