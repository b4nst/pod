 #include "config.h"
@@ -322,6 +324,49 @@ static uint32_t hash_tags(const char *album, const char *artist)
     return h;
 }
 
+/* whether name is a disc's folder of an album: CD1, Disc 2, disk_3... */
+static bool is_disc_folder(const char *name)
+{
+    static const char *const words[] = { "cd", "disc", "disk" };
+
+    for (unsigned i = 0; i < ARRAYLEN(words); i++)
+    {
+        size_t n = strlen(words[i]);
+
+        if (strncasecmp(name, words[i], n))
+            continue;
+        name += n;
+        if (*name == ' ' || *name == '_' || *name == '-')
+            name++;
+        if (!isdigit((unsigned char)*name))
+            return false;
+        while (isdigit((unsigned char)*name))
+            name++;
+        return !*name;
+    }
+    return false;
+}
+
+/* What tells an album apart from another of the same title: its album
+ * artist, or with none its folder (a disc's folder is its parent's), so the
+ * tracks of an album with several artists stay one tape. pod link keys the
+ * covers the same way (album_key in covers.rs). */
+static const char *album_key(const char *path, const char *albumartist,
+                             char *buf, size_t size)
+{
+    char *slash;
+
+    if (albumartist && *albumartist && strcmp(albumartist, UNTAGGED))
+        return albumartist;
+    strmemccpy(buf, path, size);
+    slash = strrchr(buf, '/');
+    *(slash ? slash : buf) = '\0';
+    slash = strrchr(buf, '/');
+    if (slash && is_disc_folder(slash + 1))
+        *slash = '\0';
+    return buf;
+}
+
 /* the tag of a track, or <Untagged> */
 static void get_tag(struct tagcache_search *tcs, int32_t idx, int tag,
                     char *buf, long size)
@@ -391,9 +436,10 @@ static void read_stats(const struct tagcache_search *tcs, struct deck_track *t)
