+++ b/apps/gui/skin_engine/skin_tokens.c
@@ -480,6 +480,10 @@ const char *get_id3_token(struct wps_token *token, struct mp3entry *id3,
                 itoa_buf(buf, buf_size, (elapsed / 200) % 4);
                 return buf;
 
+            case SKIN_TOKEN_TRACK_SCRUBBING:
+                /* set while SELECT has the wheel scrubbing the track */
+                return state->scrubbing ? "s" : NULL;
+
             case SKIN_TOKEN_TRACK_TIME_ELAPSED:
                 if (intval && limit == TOKEN_VALUE_ONLY)
                     *intval = elapsed/1000;
diff --git a/apps/gui/wps.c b/apps/gui/wps.c
index 51285d8acea7e388d074c97161c8210451efcdc5..82398ab1b18a1d396ce4fec9fd102f50d8519c70 100644
--- a/apps/gui/wps.c
+++ b/apps/gui/wps.c
@@ -356,6 +356,46 @@ static bool ffwd_rew(int button, bool seek_from_end)
     return usb;
 }
 
+/* pod: SELECT makes the wheel scrub the track. The wheel moves
+ * ff_rewind_count and the seek is done once it has stopped. */
+static void scrub_move(struct wps_state *state, int direction, bool *moved)
+{
+    struct mp3entry *id3 = state->id3;
+    int step = MAX(1000, (int)(id3->length / 100));
+
+    if (!*moved)
+    {
+        audio_pre_ff_rewind();
+        *moved = true;
+    }
+    state->ff_rewind_count += step * direction;
+
+    if (direction > 0)
+    {
+        if ((id3->elapsed + state->ff_rewind_count) > id3->length)
+            state->ff_rewind_count = id3->length - id3->elapsed;
+    }
+    else
+    {
+        if ((int)(id3->elapsed + state->ff_rewind_count) < 0)
+            state->ff_rewind_count = -id3->elapsed;
+    }
+}
+
+/* seek to the scrubbed position, or back to where it was when !keep */
+static void scrub_seek(struct wps_state *state, bool *moved, bool keep)
+{
+    if (*moved)
+    {
+        struct mp3entry *id3 = state->id3;
+        if (keep)
+            id3->elapsed += state->ff_rewind_count;
+        audio_ff_rewind(id3->elapsed);
+        *moved = false;
+    }
+    state->ff_rewind_count = 0;
+}
+
 static void gwps_caption_backlight(struct wps_state *state)
 {
 #if defined(HAVE_BACKLIGHT) || defined(HAVE_REMOTE_LCD)
@@ -734,6 +774,9 @@ long gui_wps_show(void)
     bool theme_enabled = true;
     long last_left = 0, last_right = 0;
     long next_idle_refresh = 0;
+    bool scrub_moved = false;
+    long scrub_until = 0, scrub_seek_at = 0;
+    struct mp3entry *scrub_id3 = NULL;
     struct wps_state *state = get_wps_state();
 
     ab_reset_markers();
@@ -827,6 +870,23 @@ long gui_wps_show(void)
 
         button = action_wpsab_single(button); /* iPods/X5/M5 */
 
+        if (scrub_moved && state->id3 != scrub_id3)
+        {   /* the track changed under the wheel: the count is stale */
+            scrub_moved = false;
+            state->ff_rewind_count = 0;
+        }
+        /* any other key ends the scrub first: skipping drops the count */
+        if (state->scrubbing && button != ACTION_NONE
+            && button != ACTION_UNKNOWN && !IS_SYSEVENT(button)
+            && button != ACTION_WPS_SCRUB
+            && button != ACTION_WPS_VOLUP && button != ACTION_WPS_VOLDOWN)
+        {
+            scrub_seek(state, &scrub_moved, button != ACTION_WPS_SKIPPREV
+                                            && button != ACTION_WPS_SKIPNEXT);
+            state->scrubbing = false;
+            update = true;
+        }
+
         switch(button)
         {
 #ifdef HAVE_HOTKEY
@@ -889,8 +949,33 @@ long gui_wps_show(void)
                 wps_do_action(WPS_PLAYPAUSE, true);
                 break;
 
+            case ACTION_WPS_SCRUB:
+                if (state->scrubbing)
+                {
+                    scrub_seek(state, &scrub_moved, true);
+                    state->scrubbing = false;
+                }
+                else if ((audio_status() & AUDIO_STATUS_PLAY) && state->id3
+                         && state->id3->length)
+                {
+                    state->scrubbing = true;
+                    scrub_until = current_tick + 3*HZ;
+                }
+                update = true;
+                break;
+
             case ACTION_WPS_VOLUP: /* fall through */
             case ACTION_WPS_VOLDOWN:
+                if (state->scrubbing)
+                {
+                    scrub_move(state, button == ACTION_WPS_VOLUP ? 1 : -1,
+                               &scrub_moved);
+                    scrub_id3 = state->id3;
+                    scrub_seek_at = current_tick + HZ/2;
+                    scrub_until = current_tick + 3*HZ;
+                    update = true;
+                    break;
+                }
                 if (button == ACTION_WPS_VOLUP)
                     adjust_volume(1);
                 else
@@ -1122,6 +1207,18 @@ long gui_wps_show(void)
                 update = true;
                 break;
         }
+
+        if (state->scrubbing)
+        {
+            if (scrub_moved && TIME_AFTER(current_tick, scrub_seek_at))
+                scrub_seek(state, &scrub_moved, true);
+            if (TIME_AFTER(current_tick, scrub_until))
+            {
+                scrub_seek(state, &scrub_moved, true);
+                state->scrubbing = false;
+                update = true;
+            }
+        }
     }
     return GO_TO_ROOT; /* unreachable - just to reduce compiler warnings */
 }
@@ -1159,6 +1256,8 @@ static void wps_state_init(void)
 {
     struct wps_state *state = get_wps_state();
     state->paused = false;
+    state->scrubbing = false;
+    state->ff_rewind_count = 0;
     if(audio_status() & AUDIO_STATUS_PLAY)
     {
         state->id3 = audio_current_track();
