 static const struct {
@@ -321,6 +356,43 @@ static void draw(struct screen *d, int sel, int f_label, int f_value,
     /* text goes over filled chips, so never paint glyph backgrounds */
     d->set_drawmode(DRMODE_FG);
 
+#if LCD_WIDTH >= 320
+    /* header: the band, the Δ mark, title, band count, on/off chip, and the
+       four stripes kicking up to the right */
+    static const unsigned stripes[] = {
+        LCD_RGBPACK(0xf7, 0xb5, 0x2c), LCD_RGBPACK(0xf2, 0x70, 0x1c),
+        LCD_RGBPACK(0xd9, 0x30, 0x2a), LCD_RGBPACK(0x7b, 0x1e, 0x3c),
+    };
+    d->set_foreground(POD_BAND);
+    d->fillrect(0, 0, LCD_WIDTH, 24);
+    for (unsigned i = 0; i < ARRAYLEN(stripes); i++)
+    {
+        int top = 24 + 2*i;
+        d->set_foreground(stripes[i]);
+        d->fillrect(0, top, 266, 2);
+        for (int k = 0; k <= top + 1; k++)
+            d->fillrect(266 + k, top - k, 1, 2);
+    }
+    d->set_foreground(POD_ACCENT);
+    d->drawline(15, 5, 8, 18);
+    d->drawline(15, 5, 22, 18);
+    d->drawline(14, 5, 7, 18);
+    d->drawline(16, 5, 23, 18);
+    d->hline(7, 23, 18);
+    d->hline(7, 23, 17);
+    d->setfont(f_label);
+    d->putsxy(30, 5, "EQUALIZER");
+    d->set_foreground(POD_LABEL);
+    d->setfont(f_tiny);
+    d->putsxy(30 + text_width(f_label, "EQUALIZER") + 8, 6, "5-BAND");
+
+    const char *state = on ? "ON" : "OFF";
+    int sw = text_width(f_tiny, state) + 10;
+    d->set_foreground(on ? POD_LABEL : POD_MID);
+    d->fillrect(258 - sw, 5, sw, th + 4);
+    d->set_foreground(POD_BAND);
+    d->putsxy(258 - sw + 5, 7, state);
+#else
     /* header: inverted bar with the Δ mark, title, band count, on/off chip */
     d->set_foreground(POD_INK);
     d->fillrect(0, 0, LCD_WIDTH, 11);
@@ -350,6 +422,8 @@ static void draw(struct screen *d, int sel, int f_label, int f_value,
             if ((x + y) % 3 == 0)
