+#define POD_INK         LCD_RGBPACK(0xed, 0xe3, 0xcf)
+#define POD_AXIS        LCD_RGBPACK(0x8c, 0x86, 0x78)
+#define POD_ACCENT      LCD_RGBPACK(0xff, 0xa5, 0x26)
+#define POD_LABEL       LCD_RGBPACK(0x46, 0xdc, 0xc8)
+
+/* plot area */
+#define GX  24
+#define GW  272
+#define GY  44
+#define GH  100
+
+#define RULE_Y      172     /* over the readout */
+#define GAIN_X      8
+#define PRESET_X    176
+#define SPLIT_X     168
