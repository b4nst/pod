From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pod <pod@localhost>
Date: Tue, 17 Nov 2026 08:18:50 +0100
Subject: [PATCH] pod: the Classic's autoreverse theme

---
 apps/bitmaps/native/SOURCES                   |   6 +-
 .../bitmaps/native/rockboxlogo.138x110x16.bmp | Bin 45814 -> 0 bytes
 .../bitmaps/native/rockboxlogo.320x240x16.bmp | Bin 0 -> 230454 bytes
 apps/bitmaps/native/usblogo.320x240x16.bmp    | Bin 0 -> 230454 bytes
 apps/gui/pod_eq.c                             | 106 +++-
 apps/gui/pod_letter.c                         |  34 +-
 apps/main.c                                   |  11 +-
 bootloader/ipod-s5l87xx.c                     |  20 +-
 bootloader/podlogo.h                          | 523 +++++++-----------
 9 files changed, 340 insertions(+), 360 deletions(-)
 delete mode 100644 apps/bitmaps/native/rockboxlogo.138x110x16.bmp
 create mode 100644 apps/bitmaps/native/rockboxlogo.320x240x16.bmp
 create mode 100644 apps/bitmaps/native/usblogo.320x240x16.bmp

diff --git a/apps/bitmaps/native/SOURCES b/apps/bitmaps/native/SOURCES
index 99fdda3689bcecfa00c30e53d5c89955314d55f9..dfbe62239b596b9d1e29679cc510ed4175dec16c 100644
--- a/apps/bitmaps/native/SOURCES
+++ b/apps/bitmaps/native/SOURCES
@@ -30,7 +30,7 @@ rockboxlogo.220x68x16.bmp
 #elif (LCD_WIDTH == 240) && (LCD_DEPTH >= 16)
 rockboxlogo.240x74x16.bmp
 #elif (LCD_WIDTH == 320) && (LCD_HEIGHT == 240) && (LCD_DEPTH >= 16)
-rockboxlogo.138x110x16.bmp
+rockboxlogo.320x240x16.bmp
 #elif (LCD_WIDTH >= 320) && (LCD_WIDTH < 480)  && (LCD_DEPTH >= 16)
 rockboxlogo.320x98x16.bmp
 #elif (LCD_WIDTH >= 480) && (LCD_WIDTH < 640) && (LCD_DEPTH >= 16)
@@ -59,7 +59,9 @@ toolsicon.130x130x16.bmp
 
 /* USB logo */
 #ifdef HAVE_LCD_COLOR
-#if LCD_WIDTH > 176
+#if (LCD_WIDTH == 320) && (LCD_HEIGHT == 240)
+usblogo.320x240x16.bmp
+#elif LCD_WIDTH > 176
 usblogo.176x48x16.bmp
 #elif LCD_WIDTH >= 128
 usblogo.128x37x16.bmp
