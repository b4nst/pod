+#define POD_ACCENT      POD_INK
+#define POD_LABEL       POD_INK
 
 /* plot area */
 #define GX  16
 #define GW  120
 #define GY  16
 #define GH  54
+
+#define RULE_Y      82
+#define GAIN_X      2
