diff --git a/apps/pod_playlog.c b/apps/pod_playlog.c
new file mode 100644
index 0000000000000000000000000000000000000000..5a4709b646a84bab359dee2fb8ea572d2bfb2e9a
--- /dev/null
+++ b/apps/pod_playlog.c
@@ -0,0 +1,149 @@
+/***************************************************************************
+ *             __________               __   ___.
+ *   Open      \______   \ ____   ____ |  | _\_ |__   _______  ___
+ *   Source     |       _//  _ \_/ ___\|  |/ /| __ \ /  _ \  \/  /
+ *   Jukebox    |    |   (  <_> )  \___|    < | \_\ (  <_> > <  <
+ *   Firmware   |____|_  /\____/ \___  >__|_ \|___  /\____/__/\_ \
+ *                     \/            \/     \/    \/            \/
+ *
