+#if LCD_WIDTH >= 320
+/* the play modes that are on, as small teal tags after the title: shuffled,
+ * Repeat all or one, Infinite */
+static void draw_mode_tags(struct screen *d, int font)
+{
+    const char *tags[3];
+    int n = 0, x = 62;
+
+    if (playlist_get_seed(NULL))
+        tags[n++] = "SHF";
+    if (global_settings.repeat_mode == REPEAT_ONE)
+        tags[n++] = "RPT1";
+    else if (global_settings.repeat_mode != REPEAT_OFF)
+        tags[n++] = "RPT";
+    if (global_settings.pod_infinite)
+        tags[n++] = "INF";
+    d->setfont(font);
+    for (int i = 0; i < n; i++)
+    {
+        int w = text_width(font, tags[i]) + 2;
+
+        d->set_foreground(POD_TEAL);
+        d->fillrect(x, 6, w, 12);
+        d->set_foreground(POD6_BAND);
+        d->putsxy(x + 1, 6, tags[i]);
+        x += w + 2;
+    }
+}
+#endif
