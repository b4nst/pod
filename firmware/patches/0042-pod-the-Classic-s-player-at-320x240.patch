+    d->setfont(f_value);
+    d->set_foreground(id3->rating ? POD_AMBER : POD_MID);
+    d->putsxy(PANE_X + 5 * STAR_BIG + 4, PLAY_Y + 11, buf);
+    d->setfont(FONT_UI);
+    d->set_foreground(POD_INK);
+    snprintf(buf, sizeof(buf), "PLAYED %ld", id3->playcount);
+    d->putsxy(PANE_X, PLAY_Y + 48, buf);
+    /* the tagcache only keeps a counter of the plays of the library */
+    snprintf(buf, sizeof(buf), "LAST %ld plays ago",
+             tagcache_get_serial() - id3->lastplayed);
+    d->set_foreground(POD_TEXT2);
+    d->putsxy(PANE_X, PLAY_Y + 68, id3->lastplayed ? buf : "LAST never");
