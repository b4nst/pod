+/* the tape: four stripes of 1 px, lit up to the cue position */
+static void draw_play_progress(struct screen *d, const struct mp3entry *id3,
+                               unsigned long elapsed)
+{
+    int w = LCD_WIDTH - PLAY_X;
+    int lit = id3->length ? (unsigned long long)MIN(elapsed, id3->length) * w
+                            / id3->length : 0;
+
+    for (int i = 0; i < 4; i++)
+    {
+        d->set_foreground(POD_HATCH(i));
+        d->fillrect(PLAY_X, PROG_Y + i, lit, 1);
+        d->set_foreground(POD_UNLIT);
+        d->fillrect(PLAY_X + lit, PROG_Y + i, w - lit, 1);
+    }
+}
+
+/* "title · artist" of the next track, or nothing past the last one */
+static void load_foot(void)
+{
+    struct tagcache_search tcs;
+    char path[MAX_PATH], title[MAX_PATH], artist[MAX_PATH];
+
+    foot.here = playlist_get_display_index() - 1;
+    foot.amount = playlist_amount();
+    foot.text[0] = '\0';
+    if (!pod_deck_next_path(1, path, sizeof(path)))
+        return;
+    title[0] = artist[0] = '\0';
+    if (tagcache_find_index(&tcs, path))
+    {
+        tagcache_retrieve(&tcs, tcs.idx_id, tag_title, title, sizeof(title));
+        tagcache_retrieve(&tcs, tcs.idx_id, tag_artist, artist,
+                          sizeof(artist));
+        tagcache_search_finish(&tcs);
+    }
+    if (!title[0])
+        strmemccpy(title, strrchr(path, '/') ? strrchr(path, '/') + 1 : path,
+                   sizeof(title));
+    if (artist[0] && strcmp(artist, UNTAGGED))
+        snprintf(foot.text, sizeof(foot.text), "%.38s \xc2\xb7 %.20s", title,
+                 artist);
+    else
+        strmemccpy(foot.text, title, sizeof(foot.text));
+}
+
+/* The footer: NEXT and the next track, or VOL and a bar of the stripes
+ * while the volume changes */
+static void draw_play_foot(struct screen *d)
+{
+    int y = FOOT_Y + (LCD_HEIGHT - FOOT_Y - font_get(f_tiny)->height) / 2;
+
+    d->set_foreground(POD6_BAND);
+    d->fillrect(PLAY_X, FOOT_Y, LCD_WIDTH - PLAY_X, LCD_HEIGHT - FOOT_Y);
+    d->setfont(f_tiny);
+    d->set_foreground(POD_AMBER);
+    if (volume_shown())
+    {
+        int min = sound_min(SOUND_VOLUME), max = sound_max(SOUND_VOLUME);
+        int w = LCD_WIDTH - 8 - FOOT_TEXT_X;
+        int lit = (global_status.volume - min) * w / MAX(1, max - min);
+
+        d->putsxy(PANE_X, y, "VOL");
+        /* segments of 3 px, each a column of the four stripes */
+        for (int x = 0; x + 3 <= w; x += 4)
+            for (int i = 0; i < 4; i++)
+            {
+                d->set_foreground(x < lit ? POD_HATCH(i) : POD_UNLIT);
+                d->fillrect(FOOT_TEXT_X + x, FOOT_Y + 3 + 2 * i, 3, 2);
+            }
+        return;
+    }
+    d->putsxy(PANE_X, y, "NEXT");
+    if (foot.here != playlist_get_display_index() - 1
+        || foot.amount != playlist_amount())
+        load_foot();
+    d->set_foreground(foot.text[0] ? POD_TEXT2 : POD_TEXT3);
+    tape_text(d, f_tiny, FOOT_TEXT_X, y, LCD_WIDTH - 4 - FOOT_TEXT_X,
+              foot.text[0] ? foot.text : "end of queue", false);
 }
 #endif
 
